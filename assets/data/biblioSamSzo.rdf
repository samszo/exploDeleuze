        <dc:subject>A-LIRE</dc:subject>
        <dc:title>Préface</dc:title>
        <dc:date>2010-05-29</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2456">
        <rdf:value>&lt;p&gt;&quot;Bref, l'homme a inventé le jeu pour apprendre, et il n'apprend bien qu'en jouant.&quot; p. 11&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>jeu</dc:subject>
        <dc:subject>apprendre</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3985">
        <rdf:value>&lt;p&gt;&quot;Imaginez un monde [...]  où le processus d'apprentissage ne pénalise pas l'erreur, mais la valorise. Ce monde n'est pas de la science fiction, il existe : c'est celui du &lt;em&gt;serious game&lt;/em&gt;, et il était temps !&quot; p. 11&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>serious game</dc:subject>
        <dc:subject>erreur</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2455">
        <rdf:value>&lt;p&gt;&quot;La découverte que le mouvement laisse une trace est la condition du jeu sans être le jeu lui-même. L'important réside dans le fait que l'enfant fait remplir à cette trace tous les rôles.&quot; p. 12&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>jeu</dc:subject>
        <dc:subject>mouvement</dc:subject>
        <dc:subject>trace</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2459">
        <rdf:value>&lt;p&gt;&quot;Tous les jeux inventés par la suite témoignent de cette même préoccupation : apprivoiser à son rythme les expériences nouvelles, les installer à l'intérieur de soi et prendre du recul par rapport à elles. Et pour cela, ils associent toujours trois moment : moteur, imagé et verbal. Le joueur agit, regarde, parle...&quot; p. 12&lt;/p&gt;</rdf:value>
        <dc:subject>Spinoza</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>jeu</dc:subject>
        <dc:subject>IN&lt;-&gt;OUT</dc:subject>
    </bib:Memo>
    <bib:BookSection rdf:about="urn:isbn:2-7381-1124-6">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dc:identifier>ISBN 2-7381-1124-6</dc:identifier>
                <dc:title>Université de tous les savoirs, volume 5 : Le Cerveau, le langage, le sens</dc:title>
            </bib:Book>
        </dcterms:isPartOf>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Paris</vcard:locality>
                    </vcard:Address>
                </vcard:adr>
                <foaf:name>Odile Jacob</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Tisseron</foaf:surname>
                        <foaf:givenName>Serge</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_1966"/>
        <dc:title>Propagande, publicité, information et désinformation</dc:title>
        <dc:date>2002-01-31</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_1966">
        <rdf:value>&lt;p&gt;&quot;Renonçons à privilégier le sens des images &quot;en soi&quot; pour envisager la signification qu'elles ont pour chacun d'entre nous, bref, leur sens &quot;pour soi&quot;. Nous y gagnerons une clairvoyance sur nous-même qu'aucun pouvoir constitué ne pourra nous arracher et qui nous mettra à l'abri de toutes les manipulations qu'engendrent leurs nouvelles technologies !&quot; p. 326&lt;/p&gt;</rdf:value>
    </bib:Memo>
