    <bib:Book rdf:about="urn:isbn:2-02-050922-9">
        <z:itemType>book</z:itemType>
        <dc:publisher>
           <foaf:Organization><foaf:name>Seuil</foaf:name></foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Bourdieu</foaf:surname>
                        <foaf:givenName>Pierre</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2612"/>
        <dcterms:isReferencedBy rdf:resource="#item_2903"/>
        <dcterms:isReferencedBy rdf:resource="#item_2613"/>
        <dcterms:isReferencedBy rdf:resource="#item_2899"/>
        <dcterms:isReferencedBy rdf:resource="#item_2614"/>
