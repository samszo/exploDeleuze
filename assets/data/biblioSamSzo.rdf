        <dc:identifier>ISSN 0395-2649</dc:identifier>
    </bib:Journal>
    <bib:Book rdf:about="urn:isbn:2-85566-351-2">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Fréjus</vcard:locality>
                    </vcard:Address>
                </vcard:adr>
                <foaf:name>Prosveta</foaf:name>
