    <bib:Memo rdf:about="#item_3164">
        <rdf:value>&lt;p&gt;&quot;6.Ainsi on peut dire, que les Monades ne sauraient commencer, ni finir, que tout d’un coup, c’est-à-dire, elles ne sauraient commencer que par création et finir que par annihilation ; au lieu, que ce qui est composé, commence ou finit par parties.&quot; p. 12&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>instant</dc:subject>
        <dc:subject>éternité</dc:subject>
    </bib:Memo>
