        <link:link rdf:resource="#item_2405"/>
        <dc:title>La physique au carrefour de l'intuitif et du symbolique : Une étude épistémologique des concepts quantiques à la lumière de la phénoménologie herméneutique</dc:title>
        <dc:date>2006-04-15</dc:date>
        <z:shortTitle>La physique au carrefour de l'intuitif et du symbolique</z:shortTitle>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-910425-21-5</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2604">
        <rdf:value>&lt;p&gt;«&amp;nbsp;… on comprend souvent les notions d'intuition et de symbole comme suit : l'intuition est la capacité qui saisit «&amp;nbsp;directement&amp;nbsp;» la réalité sans aucune médiation, tandis que le symbole (physico-chimique) concerne exclusivement la «&amp;nbsp;relation&amp;nbsp;» et révèle de la structure. Mais nous avons établi qu'il y a une autre notion d'intuition reconstruite par la médiation du symbole, qui touche cette forme de réalité saisie par le biais de la réflexion sur les concepts.&amp;nbsp;» p. 429&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>intuition</dc:subject>
        <dc:subject>symbole</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2605">
        <rdf:value>&lt;p&gt;«&amp;nbsp;La philosophie de Ricoeur, qui semble à première vue n'avoir aucun rapport avec la philosophie des sciences de la nature, peut nous aider à considérer les sciences de la nature comme des «&amp;nbsp;textes&amp;nbsp;».&amp;nbsp;» p. 429&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>physique</dc:subject>
        <dc:subject>texte</dc:subject>
    </bib:Memo>
