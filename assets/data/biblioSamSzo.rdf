    <bib:Memo rdf:about="#item_2949">
        <rdf:value>&lt;p&gt;&quot;La démarche et l'outil Ardans s'inscrivent dans une logique originale 'd'intelligence collective'. La formalisation et le partage des connaissances par chacun, leur validation en groupe dynamisent les réunions de progrés en lien avec les démarches qualités&quot; p. 204&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>outil</dc:subject>
        <dc:subject>intelligence</dc:subject>
        <dc:subject>collective</dc:subject>
    </bib:Memo>
