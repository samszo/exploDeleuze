        <dcterms:isReferencedBy rdf:resource="#item_2620"/>
        <link:link rdf:resource="#item_2409"/>
        <dc:title>De la civilisation du papier à la civilisation du numérique : A travers les aventures de l'enregistrement de la recherche, de la pensée et de l'Art</dc:title>
        <dc:date>2008-07-10</dc:date>
        <z:shortTitle>De la civilisation du papier à la civilisation du numérique</z:shortTitle>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
        <dc:identifier>ISBN 2-296-06189-3</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2611">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;… le progrès d'une science logique dépend en grande partie de la perfection des symboles qu'elle utilise. Ainsi un symbole doit satisfaire deux conditions : il doit d'abord être utilisable, il doit deuxièmement être adéquat.&amp;nbsp;» p. 146&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbole</dc:subject>
        <dc:subject>adéquat</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2609">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;… un nouveau mécanisme qui parviendrait à présenter à l'usager l'ensemble des différentes sources de la connaissance de manière dynamique, via une combinaison de texte, de son, et de langage&amp;nbsp;» p. 189&lt;/p&gt;</rdf:value>
        <dc:subject>ihm</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2951">
        <rdf:value>&lt;p&gt;«&amp;nbsp;Ce qui présente un grand intérêt dans cette étude [Solaris] est qu'elle souligne la dissociation entre le document, comme unité distincte d'information, et les sources (texte, image, son), ainsi que le fait que pour sa caractérisation dans sa forme numérique la notion utilisée est la norme, qui n'était utilisée jusqu'alors que pour les produits industriels purs.&amp;nbsp;» p. 192&lt;/p&gt;</rdf:value>
        <dc:subject>arbre</dc:subject>
        <dc:subject>double</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2622">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;Il s'agit d'un carnet de notes contemporain, en temps réel, avec des réflexions, mais qui en même temps, contient toute la connaissance dont nous aurons besoin pour soutenir ces réflexions, suivant la logique des mécanismes de mémoire développés depuis le Moyen Age jusqu'à la Renaissance.&amp;nbsp;» p. 12&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>mécanisme</dc:subject>
        <dc:subject>mémoire</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2610">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;K. Veltman depuis 1981 percevait l'ordinateur comme un système pour le repositionnement de la connaissance […] ayant surtout en tête la création d'une «&amp;nbsp;encyclopédie de la connaissance&amp;nbsp;» selon laquelle sont repositionnés a) le monde naturel ; b) le monde fait par l'homme ; et c) l'interaction entre l'homme et son monde.&amp;nbsp;» p. 187&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
        <dc:subject>organisation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3250">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;L'élément le plus important réside dans la proposition de d'Alembert pour un système complet d'organisation de la connaissance, le fameux arbre de la connaissance.&amp;nbsp;» p. 155&lt;/p&gt;</rdf:value>
        <dc:subject>arbre</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2621">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;Les règles basiques définissant les principes de la nouvelle science de l'organisation des documents sont décrites comme suit : «&amp;nbsp;Les buts de la documentation organisée consistent à pouvoir offrir sur ordre de fait et de connaissance des informations documentées : 1) universelles quant à leur objet ; 2) sûres et vraies ; 3) complètes ; 4) rapides ; 5) à jour ; 6) faciles à obtenir ; 7) réunies d'avance et prêtes à être communiquées ; 8) mises à la disposition du plus grand nombre&amp;nbsp;»&amp;nbsp;.» p. 167&lt;/p&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;cf. Paul Otlet, Traité de documentation, Editiones Mundaneum, Bruxelles, 1934&lt;/p&gt;</rdf:value>
        <dc:subject>bibliothèque</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>classification</dc:subject>
        <dc:subject>paul_otlet</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2620">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;Trois problèmes basiques se trouvent sur la route : 1) comment accédons-nous aux sources dans différents média distribués dans les musées, les bibliothèques, les archives et sur Internet ? 2) comment préstructurons-nous cette information ? 3) comment présentons-nous cette information en utilisant des interfaces cohérentes ?&amp;nbsp;» p. 189&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
        <dc:subject>organisation</dc:subject>
        <dc:subject>problème</dc:subject>
    </bib:Memo>
