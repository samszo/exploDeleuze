    <bib:Book rdf:about="urn:isbn:978-2-89596-190-1">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Montréal</vcard:locality>
