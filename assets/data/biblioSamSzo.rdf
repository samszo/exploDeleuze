        <dc:title>De la signification au sens. Pour une sémiotique sans ontologie</dc:title>
        <z:language>fr</z:language>
        <dc:identifier>
            <dcterms:URI>
               <rdf:value>http://www.revue-texto.net/index.php?id=560</rdf:value>
