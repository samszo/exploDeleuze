        <link:link rdf:resource="#item_2176"/>
        <dc:subject>A-LIRE</dc:subject>
        <dc:title>Sémantique interprétative</dc:title>
        <dc:date>2009-04-01</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-13-057495-5</dc:identifier>
        <z:numPages>304</z:numPages>
    </bib:Book>
    <bib:Memo rdf:about="#item_3144">
        <rdf:value>&lt;p&gt;&quot;Le &quot;Web sémantique&quot;, devenu une sorte de discipline internationale, puise à peu près exclusivement ses références dans la sémiotique logico-positiviste d'une philosophie du langage dépassée.&quot; p. XIV&lt;/p&gt;</rdf:value>
        <dc:subject>sémantique</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>logique</dc:subject>
        <dc:subject>Web</dc:subject>
        <dc:subject>positiviste</dc:subject>
    </bib:Memo>
