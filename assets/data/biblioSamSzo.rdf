    <bib:BookSection rdf:about="urn:isbn:2-7056-6599-4">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dc:identifier>ISBN 2-7056-6599-4</dc:identifier>
                <dc:title>Cahiers critiques de philosophie n° 2: Multiplicités deleuziennes.</dc:title>
            </bib:Book>
        </dcterms:isPartOf>
        <dc:publisher>
           <foaf:Organization><foaf:name>Hermann</foaf:name></foaf:Organization>
        </dc:publisher>
