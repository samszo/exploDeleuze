        <dcterms:dateSubmitted>2021-12-18 05:49:43</dcterms:dateSubmitted>
        <z:linkMode>1</z:linkMode>
        <link:type>application/pdf</link:type>
    </z:Attachment>
    <bib:Article rdf:about="#item_52">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>15</prism:volume>
                <dc:title>Social Science Information</dc:title>
                <prism:number>1</prism:number>
            </bib:Journal>
        </dcterms:isPartOf>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Pomian</foaf:surname>
                        <foaf:givenName>Krzysztof</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_4110"/>
        <dcterms:isReferencedBy rdf:resource="#item_4109"/>
        <dc:title>Les limites écologiques des civilisations</dc:title>
        <dc:date>1976</dc:date>
        <z:language>eng; en</z:language>
        <z:libraryCatalog>sage</z:libraryCatalog>
        <dc:rights>© Sage. All rights reserved.</dc:rights>
        <dc:description>Place: Sage CA: Thousand Oaks, CA
Publisher: Sage Publications</dc:description>
        <bib:pages>7-31</bib:pages>
    </bib:Article>
    <bib:Memo rdf:about="#item_4110">
        <rdf:value>&lt;p&gt;&quot;Les sociétés se forment et se déforment en fonction des&lt;br /&gt;relations entre les groupes. Les frontières, qui leur confèrent leurs individualités territoriales, résultent, toujours et partout de I’action des forces sociales,&lt;br /&gt;d’un équilibre instable de la violence.&quot; p.13&lt;/p&gt;</rdf:value>
        <dc:subject>frontière</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>écologie</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_4109">
        <rdf:value>&lt;p&gt;&quot;on ne connait aucun exemple d’un déclin ou d’une chute de civilisation qui aurait pu être attribuée, avec certitude, au seul fait qu’il lui était impossible de se maintenir&lt;br /&gt;dans l’environnement qu’elle avait modifié par ses activités antérieures. En revanche, il n’est pas exclu que la dégradation de l’environnement puisse&lt;br /&gt;être tenue pour une des causes importantes des déclins des civilisations&quot; p. 27&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>civilisation</dc:subject>
        <dc:subject>déclin</dc:subject>
    </bib:Memo>
