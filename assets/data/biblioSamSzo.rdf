    <bib:Memo rdf:about="#item_3407">
        <rdf:value>&lt;p&gt;&quot;Les connotations prolifèrent de façon cancéreuse, si bien qu'à chaque degré ultérieur le signe précédent est oublié, oblitéré, puisque le plaisir de la dérive réside entièrement dans le glissement d'un signe à l'autre et que ce voyage labyrinthique entre les signes et les choses n'à point d'autre but, hormis le plaisir même.&quot; p. 372&lt;/p&gt;</rdf:value>
        <dc:subject>signe</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>influence</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3408">
        <rdf:value>&lt;p&gt;“même en prenant en compte une série limitée de propriétés, on peut déterminer une parenté entre deux choses qui n’ont rien de commun entre elles” p. 371&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>rapport</dc:subject>
        <dc:subject>influence</dc:subject>
    </bib:Memo>
