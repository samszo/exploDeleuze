        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Maturana</foaf:surname>
                        <foaf:givenName>Humberto R.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Varela</foaf:surname>
                        <foaf:givenName>Francisco J.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
