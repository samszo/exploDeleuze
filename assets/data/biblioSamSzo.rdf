    <bib:Book rdf:about="urn:isbn:2-87908-072-X%20978-2-87908-072-7">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Paris</vcard:locality>
                    </vcard:Address>
                </vcard:adr>
