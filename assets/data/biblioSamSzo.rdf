    <bib:Article rdf:about="https://muse.jhu.edu/journals/canadian_historical_review/v094/94.4.milligan01.html">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:1710-1093"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Milligan</foaf:surname>
                        <foaf:givenName>Ian</foaf:givenName>
                    </foaf:Person>
