    <bib:Memo rdf:about="#item_3936">
        <rdf:value>&lt;p&gt;&lt;span lang=&quot;fr-FR&quot;&gt;« l'élaboration d'une grille de décryptage des contenus destiné au chercheur autant qu'à l'internaute. » p. 253&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>crible</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2787">
        <rdf:value>&lt;p&gt;&quot;nous souhaitons parvenir à élaborer des paradigmes, facilitant d'une part la rédaction &quot;nouvelle génération&quot; de scénarii d'usage, et d'autre part l'identification de situations de communication inédites, composante dynamique du devenir de nos sociétés.&quot; p. 252&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>paradigme</dc:subject>
        <dc:subject>scenario</dc:subject>
    </bib:Memo>
