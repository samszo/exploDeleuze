    <bib:Article rdf:about="http://www.cairn.info/resume.php?ID_ARTICLE=MULT_024_0085">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>no 24</prism:volume>
                <dc:title>Multitudes</dc:title>
                <prism:number>1</prism:number>
