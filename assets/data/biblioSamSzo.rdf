    <bib:BookSection rdf:about="urn:isbn:2-84292-158-5%20978-2-84292-158-3">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dcterms:isPartOf>
                    <bib:Series>
                        <dc:title>TLE, Théorie littérature enseignement</dc:title>
