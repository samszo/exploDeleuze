    <bib:Memo rdf:about="#item_3899">
        <rdf:value>&lt;p&gt;&quot;La frontière est donc, en fait, doublement, une zone d’empiétement : par son caractère d’objet fractal et la relativisation de sa topologie propre à l’échelle de représentation choisie ; par les luttes qui la traversent et, parfois, en déplacent le tracé.&quot; § 15&lt;/p&gt;</rdf:value>
        <dc:subject>topologie</dc:subject>
        <dc:subject>frontière</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
