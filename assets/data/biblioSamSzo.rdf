                        <foaf:surname>Bachimont</foaf:surname>
                        <foaf:givenName>Bruno</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_1856"/>
        <dcterms:isReferencedBy rdf:resource="#item_1857"/>
        <dcterms:isReferencedBy rdf:resource="#item_1855"/>
        <dcterms:isReferencedBy rdf:resource="#item_1854"/>
        <dc:title>Support de connaissance et intelligence collective : héritage et individuation technique</dc:title>
        <dc:date>2006</dc:date>
        <z:language>fr</z:language>
        <z:libraryCatalog>Google Books</z:libraryCatalog>
    </rdf:Description>
    <bib:Memo rdf:about="#item_1856">
        <rdf:value>&lt;p&gt;&quot;[deux niveaux de constitution de connaissance] : le premier correspond à un niveau cognitif, centré sur les structure conceptuelles de l'esprit ; le second correspond à un niveau plus collectif, centré sur les structures d'héritage et de transmission de la culture.&quot; p. 56&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
        <dc:subject>niveau</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1857">
        <rdf:value>&lt;p&gt;&quot;La connaissance résulte d'un jeu permanent d'internalisation et d'externalisation de manipulation matérielle d'objets : de la manipulation des cailloux qui ont donné naissance au calcul à la matérialisation sur le manuscrit des mnémotechniques monastiques (inde, tables de matières, etc.), on constate que nos structures et performances cognitives constituent nos technologies intellectuelles autant qu'elles en sont les conséquences.&quot; p. 55&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>IN&lt;-&gt;OUT</dc:subject>
        <dc:subject>cognition</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1855">
        <rdf:value>&lt;p&gt;&quot;La notion de couche en informatique, via celle de l'implantation et de compilation, permet de représenter les structures formelles en faisant abstraction des calculs élémentaires induits, comme la formule permet de s'abstraire du sens.&quot; p. 62&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>couche</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1854">
        <rdf:value>&lt;p&gt;&quot;la notion de couche est une manière également de réduire la complexité et de rapporter une masse quasi infinie de calculs formels à des structures plus intelligibles pour l'être humain.&quot; p. 63&lt;/p&gt;</rdf:value>
        <dc:subject>complexité</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>couche</dc:subject>
        <dc:subject>infini</dc:subject>
    </bib:Memo>
    <rdf:Description rdf:about="#item_397">
        <z:itemType>conferencePaper</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <dc:identifier>ISBN 978-2-911762-71-0</dc:identifier>
                <dc:title>Intelligence collective Rencontre 2006</dc:title>
