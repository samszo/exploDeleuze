    <bib:Memo rdf:about="#item_2906">
        <rdf:value>&lt;p&gt;&quot;... il est en effet un espace destiné à l'élévation de l'âme et à l'exercice de l'otium (le repos de valeur positive).&quot; p. 252&lt;/p&gt;</rdf:value>
        <dc:subject>jardin</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbolique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2821">
        <rdf:value>&lt;p&gt;&quot;Le jardin représente un espace sacré et une dimension initiatique distincte de la réalité quotidienne. Comme tel, il est un lieu protégé, ceint de murs (l'hortus conclusus) ou de palissades symbolique...&quot; p. 252&lt;/p&gt;</rdf:value>
        <dc:subject>jardin</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>hortus conclusus</dc:subject>
    </bib:Memo>
