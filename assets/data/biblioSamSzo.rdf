        <dc:title>Les phénomène de la voie</dc:title>
        <dc:date>1979-11-01</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2836">
        <rdf:value>&lt;p&gt;&quot;Nous sommes possédés par nos contenus psychiques autonomes exactement comme s'ils étaient des dieux. On les appelle maintenant phobies, impulsions, etc., bref, symptôme névrotiques. Les dieux sont devenus des maladies : Zeus ne régit plus l'Olympe, mais le plexus solaire et il crée des cas pour les cabinet de médecins, ou encore trouble le cerveau des politiciens et des journalistes qui déclenchent sans le savoir des épidémies psychiques.&quot; p.54&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>divin</dc:subject>
        <dc:subject>maladie</dc:subject>
    </bib:Memo>
