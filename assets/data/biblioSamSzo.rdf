    <rdf:Description rdf:about="http://hal.inria.fr/docs/00/91/62/81/PDF/csmr14-diversify.pdf">
        <z:itemType>conferencePaper</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <dc:title>Proc. of the Int. Conf. on Software Maintenance and Reengineering (CSMR)</dc:title>
            </bib:Journal>
