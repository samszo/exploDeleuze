                        <foaf:surname>Boulesnane</foaf:surname>
                        <foaf:givenName>Sabrina</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Bouzidi</foaf:surname>
                        <foaf:givenName>Laïd</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
