        <dcterms:isReferencedBy rdf:resource="#item_2309"/>
        <link:link rdf:resource="#item_2308"/>
        <dc:subject>
            <z:AutomaticTag>
                <rdf:value>Architecture -- Dessins et plans -- Thèses et écrits académiques</rdf:value>
            </z:AutomaticTag>
