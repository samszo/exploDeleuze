        <link:link rdf:resource="#item_2402"/>
        <dc:title>La gestion des connaissances</dc:title>
        <dc:date>2003-03-11</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-7462-0660-9</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2599">
        <rdf:value>&lt;p&gt;«&amp;nbsp;Le cycle de la connaissance peut-être illustré par la métaphore du cycle de l'eau. Les connaissance tacites peuvent être comparées aux masse nuageuses, l'explicitation de ces connaissances se compare alors au processus de précipitation, où la vapeur d'eau se condense en phase liquide sur le sol&amp;nbsp;» p. 53&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
        <dc:subject>eau</dc:subject>
    </bib:Memo>
