    <bib:Thesis rdf:about="http://tel.archives-ouvertes.fr/tel-00650319">
        <z:itemType>thesis</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Rennes</vcard:locality>
                    </vcard:Address>
