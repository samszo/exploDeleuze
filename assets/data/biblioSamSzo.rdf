    <bib:Memo rdf:about="#item_2819">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;&quot;étymologiquement, dire une chose pour une autre ... représenter une idée abstraite par une image, peupler le champ visuel d'objets considérés comme le signe d'une réalité invisible.&quot; p.6&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2820">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;&quot;[l'allégorie] n'est parfaitement codifiée qu'au XVIIe et XVIIIe siècles. Elle traduit les nuances nouvelles de l'art religieux, mais elle trouve son terrain le plus favaorable dans l'art profane.&quot; p.5&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
    </bib:Memo>
