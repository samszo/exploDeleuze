    <bib:Article rdf:about="http://sites.uclouvain.be/rec/index.php/rec/article/view/11">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:2033-3331"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Brouwers</foaf:surname>
                        <foaf:givenName>Aurélie</foaf:givenName>
                    </foaf:Person>
