        <z:linkMode>1</z:linkMode>
        <link:type>application/pdf</link:type>
    </z:Attachment>
    <bib:Book rdf:about="urn:isbn:978-2-13-081414-6">
        <z:itemType>book</z:itemType>
        <dcterms:isPartOf>
