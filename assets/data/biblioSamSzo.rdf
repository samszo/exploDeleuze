    <bib:Book rdf:about="urn:isbn:978-1-4555-4459-2">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>New York, NY</vcard:locality>
                    </vcard:Address>
