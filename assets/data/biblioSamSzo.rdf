        <dcterms:dateSubmitted>2013-10-06 08:42:01</dcterms:dateSubmitted>
        <z:linkMode>1</z:linkMode>
        <link:type>text/html</link:type>
    </z:Attachment>
    <bib:Article rdf:about="http://www.cairn.info/article.php?ID_ARTICLE=DBU_PAQUA_2006_01_0179">
        <z:itemType>journalArticle</z:itemType>
