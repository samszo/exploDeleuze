        <link:link rdf:resource="#item_2027"/>
        <dc:title>L'énnéagramme : 9 types de personnalité pour mieux se connaître</dc:title>
        <dc:date>2010-06-03</dc:date>
        <z:shortTitle>L'énnéagramme</z:shortTitle>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
        <dc:identifier>ISBN 2-212-54622-X</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2499">
        <rdf:value>&lt;p&gt;&quot;L'ennéagramme moderne [...] trouve son origine indiscutable dans l'enseignement que propose, au début de année 1970, le Bolivien Oscar Ichazo (né en 1931) à Arica [...] à la recherche d'une évolution spirituelle autour d'un enseignement visant à atteindre &quot;l'illumination de manière scientifique&quot; &quot;&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>science</dc:subject>
        <dc:subject>illumination</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2496">
        <rdf:value>&lt;p&gt;&quot;l'ennéagramme n'est pas une simple typologie des personnalités, statique et figée, mais un système riche et dynamique qui permet de se rencontrer au plus profond de soi. Il décrit neuf visions différentes du monde, et en conséquence neuf manière très différentes d'interagir avec celui-ci.&quot; p . 7&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
    </bib:Memo>
    <z:Attachment rdf:about="#item_2027">
        <z:itemType>attachment</z:itemType>
        <dc:title>Amazon.com Link</dc:title>
