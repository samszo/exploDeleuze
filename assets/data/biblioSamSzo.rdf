                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Hiernaux</foaf:surname>
                        <foaf:givenName>Quentin</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_1672"/>
        <dcterms:isReferencedBy rdf:resource="#item_1676"/>
        <dcterms:isReferencedBy rdf:resource="#item_1673"/>
        <dc:title>Biologie et mésologie : une perspective végétale</dc:title>
        <dc:date>16 avril 2018</dc:date>
        <z:language>Français</z:language>
        <bib:pages>301-310</bib:pages>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_1672">
        <rdf:value>&lt;p&gt;&quot;le caractère fixé et autotrophe des plantes implique une plus grande nécessité de s'adapter à leur environnement. Cela se manifeste d'une part par une grande capacité de modification de leur milieu (construction de niche) et d'autre part par une grande capacité de transformation de son propre corps, c'est ce qu'on appelle la plasticité végétale (elles est à la fois morphologique, mais aussi épigénétique).&lt;/p&gt;
&lt;p&gt;Or ces caractéristiques se révèlent déterminantes pour favoriser une pensée plus écologique de la biologie. [•••] On est alors conduit à penser l'organisme et son milieu en termes de co-construction et non plus simplement selon un déterminisme causal et unidirectionnel.&quot; p. 305&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>végétal</dc:subject>
        <dc:subject>plasticité</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1676">
        <rdf:value>&lt;p&gt;&quot;Plutôt que d'insister sur l'idée que les animaux &lt;em&gt;ont&lt;/em&gt; un milieu, les plantes manifestent d'abord l'idée qu'elles &lt;em&gt;sont&lt;/em&gt; un milieu&quot; p. 308&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>milieu</dc:subject>
        <dc:subject>avoir</dc:subject>
        <dc:subject>être</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1673">
        <rdf:value>&lt;p&gt;&quot;Privilégier des explications en termes de dynamiques, de flux, de relations, d'interfaces et de processus évite les écueils du dualisme, de l'objectivisation ou de la substantialisation des organismes et de leurs milieux.&quot; p. 306&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>épistémologie</dc:subject>
        <dc:subject>écosystémique</dc:subject>
    </bib:Memo>
    <bib:Book rdf:about="urn:isbn:2-7073-1942-2">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Les Editions de Minuit</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
