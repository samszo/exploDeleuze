    <bib:Thesis rdf:about="https://tel.archives-ouvertes.fr/tel-01996608/document">
        <z:itemType>thesis</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Université Panthéon-Sorbonne - Paris I</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Fernandez-Moujan</foaf:surname>
                        <foaf:givenName>Carola</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
