        <dc:subject>interprétation</dc:subject>
        <dc:title>Les limites de l'interprétation</dc:title>
        <dc:date>1 mars 1994</dc:date>
        <z:language>Français</z:language>
        <z:libraryCatalog>Amazon</z:libraryCatalog>
