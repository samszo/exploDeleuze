        <dc:title>Chapitre10. L'analyse structurale de contenu, une démarche pour l'analyse des représentations</dc:title>
        <dc:date>2006-01-01</dc:date>
        <z:language>fr</z:language>
        <z:libraryCatalog>accesdistant.bu.univ-paris8.fr:2056</z:libraryCatalog>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>http://www.cairn.info/article.php?ID_ARTICLE=DBU_PAQUA_2006_01_0179</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2013-10-06 08:34:54</dcterms:dateSubmitted>
        <dc:rights>© De Boeck Supérieur</dc:rights>
        <bib:pages>179-191</bib:pages>
    </bib:Article>
    <bib:Memo rdf:about="#item_3182">
        <rdf:value>&lt;p&gt;Dans &lt;em&gt;la structure croisée&lt;/em&gt;, la plus complexe des trois, deux disjonctions constituent deux axes sémantiques orthogonaux dont le croisement génère d’autres disjonctions&amp;nbsp;:&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;reference1&quot; style=&quot;width: 135px; font-size: 12px; top: 109px;&quot;&gt;&lt;img style=&quot;cursor: pointer;&quot; src=&quot;http://accesdistant.bu.univ-paris8.fr:2056/loadimg.php?FILE=DBU_PEDA/DBU_PAQUA_2006_01/DBU_PAQUA_2006_01_0179/smallANQUED_INT_art13_img006.jpg&quot; alt=&quot;...&quot; /&gt;&lt;br /&gt;&lt;/span&gt;Les disjonctions produites par le croisement des deux axes orthogonaux «&amp;nbsp;héritent&amp;nbsp;» des valorisations correspondantes de ceux-ci et présentent des valorisations inverses entre leurs termes respectifs.&lt;/p&gt;</rdf:value>
        <dc:subject>sémantique</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>axe</dc:subject>
    </bib:Memo>
