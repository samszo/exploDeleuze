                <rdf:value>https://tel.archives-ouvertes.fr/tel-01292572/document</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2016-07-06 04:23:43</dcterms:dateSubmitted>
        <z:type>phdthesis</z:type>
    </bib:Thesis>
