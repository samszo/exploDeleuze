    <bib:Article rdf:about="http://accesdistant.bu.univ-paris8.fr:2073/article.php?ID_ARTICLE=MULT_027_0203&amp;AJOUTBIBLIO=MULT_027_0203">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
