        <bib:pages>405-411</bib:pages>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:0395-2649">
        <prism:volume>32</prism:volume>
        <dc:title>Annales. Économies, Sociétés, Civilisations</dc:title>
