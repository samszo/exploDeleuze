        <z:linkMode>3</z:linkMode>
        <link:type>text/html</link:type>
    </z:Attachment>
    <bib:Book rdf:about="urn:isbn:978-2-7296-0189-8">
        <z:itemType>book</z:itemType>
        <dc:publisher>
           <foaf:Organization><foaf:name>Academia</foaf:name></foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Dubois</foaf:surname>
                        <foaf:givenName>Daniel</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2719"/>
        <dcterms:isReferencedBy rdf:resource="#item_1945"/>
        <dcterms:isReferencedBy rdf:resource="#item_2117"/>
