    <bib:Memo rdf:about="#item_2928">
        <rdf:value>&lt;p&gt;&quot;Confondre accès et référence serait en effet oublier que le lien symbolique usuel entre mots et choses ne nécessite aucunement de se voir implémenté&amp;nbsp; d’une quelconque manière. Nul besoin d’avoir recours à des moyens d’ordres techniques pour qu’un mot atteigne son objet, aucun artefact n’y pourvoira&quot; p. 3&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbole</dc:subject>
        <dc:subject>tag</dc:subject>
    </bib:Memo>
