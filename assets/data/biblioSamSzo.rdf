        <dc:subject>A-LIRE</dc:subject>
        <dc:title>Enquêtes sur les modes d'existence : Une anthropologie des Modernes</dc:title>
        <dc:date>2012-09-20</dc:date>
        <z:shortTitle>Enquêtes sur les modes d'existence</z:shortTitle>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
        <dc:identifier>ISBN 2-7071-7347-9</dc:identifier>
        <z:numPages>498</z:numPages>
    </bib:Book>
    <bib:Memo rdf:about="#item_3745">
        <rdf:value>&lt;p&gt;&quot;Ce qui amène à définir une scène diplomatique imaginaire [...] au nom de qui négocier [] et avec qui négocier ?&quot; p.25&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>imaginaire</dc:subject>
        <dc:subject>diplomatie</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3743">
        <rdf:value>&lt;p&gt;&quot;En apprenant à repérer différents modes d'existence&quot; p. 31&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>mode</dc:subject>
        <dc:subject>existence</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3746">
        <rdf:value>&lt;p&gt;&quot;en proposant un autre système de coordonnées.&quot; p.22&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>système</dc:subject>
        <dc:subject>coordonnées</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3748">
        <rdf:value>&lt;p&gt;&quot;Entre moderniser ou écologiser, il faut choisir.&quot; p. 20&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>modernité</dc:subject>
        <dc:subject>écologie</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3747">
        <rdf:value>&lt;p&gt;&quot;était moderne celui qui s'émancipait des attachement de son passé pour avancer vers la liberté.&quot; p.21&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>liberté</dc:subject>
        <dc:subject>moderne</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3749">
        <rdf:value>&lt;p&gt;&quot;il est inconcevable qu'il n'y ait pas d'urbaniste pour leur proposer les dessins d'un habitacle provisoire qui permette d'abriter les masses qui errent entre la dystopie de l'économie et l'utopie de l'écologie.&quot; p. 35&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>économie</dc:subject>
        <dc:subject>écologie</dc:subject>
        <dc:subject>urbanisme</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3744">
        <rdf:value>&lt;p&gt;&quot;L'enquête ressemble d'abord à celle sur les actes de langages&quot; p. 29&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>langage</dc:subject>
        <dc:subject>acte</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3742">
        <rdf:value>&lt;p&gt;&quot;Le but est d'abord d'accompagner un peuple errant entre l'économie et l'écologie.&quot; p. 34&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>économie</dc:subject>
        <dc:subject>écologie</dc:subject>
        <dc:subject>peuple</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3750">
        <rdf:value>&lt;p&gt;&quot;Mais, comme il s'agit de couvrir enfin l'abîme qui sépare, chez les Modernes, ce qu'ils disent de ce qu'ils font, je n'ai pas vu comment cette enquête sur les modes d'existence pouvait se passer de la philosophie. Non pas dans le vain espoir de trouver dans les &quot;fondements&quot; ce que l'étude de terrain ne saurait donner mais,  au contraire, pour avoir une chance de forger le métalangage qui permette de rendre enfin justice, dans la théorie, aux inventions stupéfiantes que les terrains révèlent à chaque pas - chez les Modernes aussi.&quot; p. 33&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>théorie</dc:subject>
        <dc:subject>moderne</dc:subject>
        <dc:subject>invention</dc:subject>
        <dc:subject>métalangage</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1768">
        <rdf:value>&lt;p&gt;&lt;strong style=&quot;font-weight:normal;&quot;&gt;&lt;span style=&quot;font-size:13px;font-family:Arial;color:#000000;background-color:transparent;font-weight:normal;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;&quot;&gt; “S’il s’agit d’écologiser et non plus de moderniser, il va peut-être devenir possible de faire cohabiter un plus grand nombre de valeurs dans un écosystème plus riche.” p. 23&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>modernité</dc:subject>
        <dc:subject>écosystème</dc:subject>
    </bib:Memo>
