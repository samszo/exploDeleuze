    <bib:BookSection rdf:about="https://www.cairn.info/les-differents-modes-d-existence--9782130574873-p-195.htm">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dcterms:isPartOf>
                   <bib:Series><dc:title>MétaphysiqueS</dc:title></bib:Series>
                </dcterms:isPartOf>
                <dc:identifier>ISBN 978-2-13-057487-3</dc:identifier>
                <dc:title>Les différents modes d’existence</dc:title>
            </bib:Book>
        </dcterms:isPartOf>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Paris cedex 14</vcard:locality>
                    </vcard:Address>
                </vcard:adr>
                <foaf:name>Presses Universitaires de France</foaf:name>
