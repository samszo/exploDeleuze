    <bib:Book rdf:about="urn:isbn:2-02-104565-X">
        <z:itemType>book</z:itemType>
        <dc:publisher>
           <foaf:Organization><foaf:name>Seuil</foaf:name></foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Weiss</foaf:surname>
                        <foaf:givenName>Allen S.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2918"/>
        <dcterms:isReferencedBy rdf:resource="#item_2886"/>
        <link:link rdf:resource="#item_2436"/>
        <dc:title>Miroirs de l'infini : Le jardin à la française et la métaphysique au XVIIe siècle</dc:title>
        <dc:date>2011-03-17</dc:date>
        <z:shortTitle>Miroirs de l'infini</z:shortTitle>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-02-104565-X</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2918">
        <rdf:value>&lt;p&gt;&quot;Cet effroyable silence de l'espace infini, qu'aucun symbole ne peut exprimer, pas même le jardin comme microcosme, anéantit notre vanité.&quot; p. 102&lt;/p&gt;</rdf:value>
        <dc:subject>jardin</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>silence</dc:subject>
        <dc:subject>vanité</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2886">
        <rdf:value>&lt;p&gt;&quot;le paradigme du microcosme comme signe de vérité fut banni de la métaphysique, de l'ontologie et de l'épistémologie et relégué dans le domaine de l'esthétique, là où il nous est possible d'échapper aux lois physiques et métaphysiques universelles par la seule force de notre volonté désentravée. Ce changement de paradigme [...] est précisément une des origines philosophique de la modernité. Les lois et les effets esthétiques, construits au-delà des limites de l'entendement humain et en fait indépendants du besoin de connaissance, permettent l'effacement de l'esprit géométrique, tout en utilisant précisément les mêmes lois mathématiques à des fins esthétiques&quot; p. 120&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>modernité</dc:subject>
        <dc:subject>esthétique</dc:subject>
        <dc:subject>géométrie</dc:subject>
    </bib:Memo>
