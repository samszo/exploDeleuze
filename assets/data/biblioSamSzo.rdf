        <dc:title>La méthode, La connaissance de la connaissance, tome 3</dc:title>
        <dc:date>1992-01-02</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
