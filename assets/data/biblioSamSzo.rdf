    <bib:BookSection rdf:about="#item_757">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dc:identifier>ISBN 2-226-02820-X 978-2-226-02820-4</dc:identifier>
                <dc:title>Synchronicite et Paracelsica</dc:title>
            </bib:Book>
        </dcterms:isPartOf>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Paris</vcard:locality>
                    </vcard:Address>
                </vcard:adr>
                <foaf:name>A.Michel</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Jung</foaf:surname>
                        <foaf:givenName>Carl Gustav</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2830"/>
        <dcterms:isReferencedBy rdf:resource="#item_2831"/>
        <dcterms:isReferencedBy rdf:resource="#item_3755"/>
        <dcterms:isReferencedBy rdf:resource="#item_2826"/>
        <dcterms:isReferencedBy rdf:resource="#item_3402"/>
        <dcterms:isReferencedBy rdf:resource="#item_2829"/>
        <dcterms:isReferencedBy rdf:resource="#item_2828"/>
        <dcterms:isReferencedBy rdf:resource="#item_2827"/>
        <dc:title>La synchronicité, principe de relations acausales</dc:title>
        <dc:date>1950</dc:date>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2830">
        <rdf:value>&lt;p&gt;&quot; [Leibniz] compare l'âme et le corps à deux &lt;em&gt;horloges synchronisées&lt;/em&gt;, et il se sert de la même analogie pour exprimer aussi les rapports des monades ou entéléchies entre elles.&quot; p. 89&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>monade</dc:subject>
        <dc:subject>synchronisation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2831">
        <rdf:value>&lt;p&gt;&quot; [Paracelse dit] que le médecin ne trouve rien dans l'homme qui ne soit aussi dans le ciel et la terre ; ceux-ci ne se distinguent pas l'un de l'autre davantage que l'apparence et la forme, puisque la forme a été saisie des deux côtés comme une chose unique.&quot; p. 87&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>macrocosme</dc:subject>
        <dc:subject>médecin</dc:subject>
        <dc:subject>microcosme</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3755">
        <rdf:value>&lt;p&gt;&quot;En tant que représentant du Yin et du Yang ces nombre [le tirage des pièces] sont, sous la forme des opposés, mères et pères de tout ce qui advient, la propriété spécifique à la fois de l'inconscient et de la nature, et ils constituent de ce fait le &lt;em&gt;tertium comparationis&lt;/em&gt; entre le monde intérieur, psychique, et le monde extérieur, physique. C'est ainsi que les deux ancêtres ont inventé une méthode permettant de représenter un état intérieur par un état extérieur, et vice versa.&quot; p. 54&lt;/p&gt;</rdf:value>
        <dc:subject>Yi jing</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>IN&lt;-&gt;OUT</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2826">
        <rdf:value>&lt;p&gt;&quot;L'archétype est la forme propre de la probabilité psychique en ce sens qu'il remplit en quelque sorte une fonction d'organisation typologique des processus instinctuels, représentative d'une moyenne.&quot; p. 105&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>archétype</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3402">
        <rdf:value>&lt;p&gt;&quot;le savoir se trouve dans un continuum spatio-temporel où l'espace n'est plus l'espace, et le temps n'est plus le temps.&quot; p. 75&lt;/p&gt;</rdf:value>
        <dc:subject>temps</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>espace</dc:subject>
        <dc:subject>savoir</dc:subject>
        <dc:subject>continuum</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2829">
        <rdf:value>&lt;p&gt;&quot;Pour nous les détails comptent en eux-même, en tant que tels ; pour la pensée orientale ils sont toujours le complément d'une image d'ensemble. Or dans cette totalité sont contenues [...] des choses dont le lien avec d'autres choses ne peut plus être conçu comme &quot;fortuit&quot;, comme une coïncidence dont le caractère signifiant paraît arbitraire.&quot; p. 82&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>détail</dc:subject>
        <dc:subject>globalité</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2828">
        <rdf:value>&lt;p&gt;&quot;Selon Liebniz, &quot;les âmes en général sont des miroirs vivants ou images de l'univers des créature...&quot;. il les distingue d'une part des esprits, qui sont des &quot;images de la Divinité même, capables de connaître le système de l'univers et d'en imiter quelque chose par des échantillons architectoniques, chaque esprit étant comme une petite divinité dans son département&quot;, et d'autre part des corps, ceux-ci agissant &quot;selon les lois des causes efficientes ou des mouvements&quot;, cependant que les âmes agissent &quot;selon les lois des causes finales par appétitions, fins et moyens&quot;.&quot; p. 89&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>intérieur</dc:subject>
        <dc:subject>physicalité</dc:subject>
        <dc:subject>monade</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2827">
        <rdf:value>&lt;p&gt;&quot;Si les dernières conclusions auxquelles est arrivée la science vont dans le sens d'une conception unitaire de l'être incluant d'une part les aspects d'espace et de temps et d'autre par ceux de causalité et de synchronicité, cela n'a rien à voir avec le matérialisme. Il parait bien plutôt que l'on découvre ici la possibilité d'éliminer l'hétérogénéité radicale de l'observateur et de la chose observée. Si tel était le cas, il en résulterait une unité de l'être que l'on ne pourrait exprimer qu'en usant d'un langage conceptuel nouveau, d'un &quot;langage neutre&quot;, selon l'excellente formulation de Wolfgang Pauli.&quot; p. 102&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>IEML</dc:subject>
        <dc:subject>langage</dc:subject>
    </bib:Memo>
