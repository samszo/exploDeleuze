    <bib:Book rdf:about="urn:isbn:978-2-7010-1072-4">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Editions Beauchesne</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Brunn</foaf:surname>
                        <foaf:givenName>Émilie Zum</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Libera</foaf:surname>
                        <foaf:givenName>Alain de</foaf:givenName>
                    </foaf:Person>
