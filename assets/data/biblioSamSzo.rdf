        <z:linkMode>3</z:linkMode>
        <link:type>text/html</link:type>
    </z:Attachment>
    <bib:Book rdf:about="urn:isbn:2-87811-193-1">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Thames &amp; Hudson</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Wildbur</foaf:surname>
                        <foaf:givenName>Peter</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Burke</foaf:surname>
                        <foaf:givenName>Michael</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2071"/>
        <dcterms:isReferencedBy rdf:resource="#item_2678"/>
        <dcterms:isReferencedBy rdf:resource="#item_2677"/>
        <dcterms:isReferencedBy rdf:resource="#item_2679"/>
        <dcterms:isReferencedBy rdf:resource="#item_2964"/>
        <link:link rdf:resource="#item_2072"/>
        <dc:title>Le Graphisme d'information : Cartes, diagrammes, interfaces et signalétiques</dc:title>
        <dc:date>2004-05-18</dc:date>
        <z:shortTitle>Le Graphisme d'information</z:shortTitle>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-87811-193-1</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2071">
        <rdf:value>&lt;p&gt;bonne historique de l'histoire des représentations statistiques&lt;/p&gt;</rdf:value>
        <dc:subject>commentaires</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2678">
        <rdf:value>&lt;p&gt;&quot;C'est ainsi que le numérique et l'analogique sont de plus en plus utilisés conjointement, afin de fournir des informations précises à la fois chiffrés et contextuelles. L'un des grands défis de la conception graphique est de trouver des solutions permettant d'intégrer ces deux modes de communication complémentaires en un tout parfaitement homogène.&quot; p. 11&lt;/p&gt;</rdf:value>
        <dc:subject>numérique</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>analogique</dc:subject>
        <dc:subject>défis</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2677">
        <rdf:value>&lt;p&gt;&quot;Ces systèmes de navigation personnels comprendront probablement un écran dont l'affichage pourra être modifié en fonction du choix de l'automobiliste parmi les trois modes graphiques suivants : alphabétique (accompagne de description vocales), symbolique (flèches et pictogrammes) ou cartographique (un curseur pouvant être déplacé sur une carte simplifié).&quot; p. 16&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbole</dc:subject>
        <dc:subject>navigation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2679">
        <rdf:value>&lt;p&gt;&quot;De manière générale, le mode de présentation analogique code un contexte graphique en même temps que l'information elle-même, permettant à l'utilisateur à la fois de comprendre le message et de le situer par rapport à des paramètres reconnaissables.&quot; p. 10&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>analogique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2964">
        <rdf:value>&lt;p&gt;&quot;La fusion de la typographie et du graphisme, de l'image animée, du son et de la musique requiert un enseignement à la fois artistique et technique ainsi qu'une capacité de réalisation et de coordination mutimédia. Un tel programme n'en est aujourd'hui qu'à ses balbutiements et il se peut qu'à l'avenir, la formation des concepteurs graphistes devienne semblable en durée et en structure au cursus suivi par les architectes.&quot; p. 17&lt;/p&gt;</rdf:value>
        <dc:subject>architecture</dc:subject>
        <dc:subject>design</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>prospective</dc:subject>
        <dc:subject>enseignement</dc:subject>
    </bib:Memo>
