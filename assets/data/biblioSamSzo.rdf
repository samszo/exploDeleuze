    </bib:Book>
    <bib:Memo rdf:about="#item_2847">
        <rdf:value>&lt;p&gt;&quot;Les langages algébriques, aussi appelés langages hors contexte (contexte free en anglais) constituent le deuxième niveau de la hiérarchie de Chomsky. Il furent initialement introduits pour modéliser les langues naturelles. Cette approche a été relativement abandonné [...] Par contre, ce modèle c'est avéré particulièrement adapté pour decrire la syntaxe des langages de programmation.&quot; p. 76&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>langage</dc:subject>
        <dc:subject>algébrique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2848">
        <rdf:value>&lt;p&gt;&quot;Les langages rationnels sont le premier niveau de la hiérarchie de Chomsky. Cette famille est constitué des langages acceptés par les automates finis qui sont le modèle le plus simple de machine.&quot; p. 13&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>langage</dc:subject>
        <dc:subject>Chomsky</dc:subject>
        <dc:subject>rationnel</dc:subject>
    </bib:Memo>
