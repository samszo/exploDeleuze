        <dcterms:isReferencedBy rdf:resource="#item_2568"/>
        <dc:title>Les connaissances naïves en mathématiques</dc:title>
        <dc:date>2008</dc:date>
        <z:libraryCatalog>Google Books</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2569">
        <rdf:value>&lt;p&gt;&quot;Comme la régression métaphorique à l'infini n'est pas envisagée, c'est à l'interaction avec l'environnement dès la prime enfance qu'est attribuée la construction des métaphores originelles sur lesquelles se greffent par la suite des métaphores plus conceptuelles.&quot; p. 60&lt;/p&gt;</rdf:value>
        <dc:subject>métaphore</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2576">
        <rdf:value>&lt;p&gt;&quot;L'essor des sciences affectives avec la multiplication des recherches s'inscrivant dans la thématique cognition et émotion reflète aussi le développement de cette mouvance. Ces travaux ont en commun de refuser la dissociation entre le corps et l'esprit et remettent en cause de manière plus ou moins explicite l'idée selon laquelle les lois logique formelle sont implémentées directement dans le psychisme humain&quot; p. 58&lt;/p&gt;</rdf:value>
        <dc:subject>affect</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>formel</dc:subject>
        <dc:subject>vs</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2570">
        <rdf:value>&lt;p&gt;&quot;L'idée directrice de Lakoff et Johnson est simple : loin d'être une simple figure de style à l'usage des poètes, des littéraires et des rhétoriciens, la métaphore est le mode naturel d'organisation conceptuelles pour l'être humain. Les notions trop abstraites pour être appréhendées directement le sont par des métaphores, qui sont indispensables pour comprendre, raisonner et prendre des décisions.&quot; p. 59&lt;/p&gt;</rdf:value>
        <dc:subject>métaphore</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>abstrait</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2373">
        <rdf:value>&lt;p&gt;&quot;Les connaissances naïves tiennent de la catégorisation leur caractère spontané, automatique, non conscient et leur robustesse, de la métaphore leur nature imagée et le transport entre deux champs sémantique, elles tiennent enfin de l'analogie leur caractère approximatif et le fait que des connaissances familières servent à appréhender des notions qui le sont moins.&quot; p. 57&lt;/p&gt;</rdf:value>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2567">
        <rdf:value>&lt;p&gt;&quot;les structures profondes et induites définissent des catégories de situations qui permettent d'analyser les relations entre compétence et performance. La compétence que l'enseignant cherche à faire acquérir s'identifie à la structure profonde alors que la performance résulte de la mise en oeuvre de procédures associées à la structure induite.&quot; p. 81&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>IN&lt;-&gt;OUT</dc:subject>
        <dc:subject>structure</dc:subject>
        <dc:subject>profonde</dc:subject>
        <dc:subject>surface</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2575">
        <rdf:value>&lt;p&gt;&quot;Poincaré (1905) raille les mathématiciens qui prétendent se hisser vers une vérité démontrée par la seule force de l'axiomatique et de la logique et considère que l'analogie est au coeur de la pensée mathématique&quot; p. 71&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>mathématique</dc:subject>
        <dc:subject>analogie</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2568">
        <rdf:value>&lt;p&gt;«&amp;nbsp; structure induite, qui peut se définir comme l'abstraction relationnelle qui émerge des propriétés des objets de la situation décrite et des relations qu'ils entretiennent, est construite à partir des traits de surface énoncé [...] Le transfert devient alors une question de mise en relation entre structures perçues.&lt;/p&gt;
&lt;p&gt;Cette contribution est essentielle car elle ne dissocie pas la surface et la structure, qui deviennent deux facettes de la représentation : l'une, inductrice, renvoie à la surface et l'autre, induite, à la structure&amp;nbsp;» p. 80&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>IN&lt;-&gt;OUT</dc:subject>
        <dc:subject>structure</dc:subject>
        <dc:subject>induction</dc:subject>
    </bib:Memo>
