    </z:Attachment>
    <bib:Article rdf:about="https://www.cairn.info/revue-techniques-et-culture-2020-1-page-208.htm">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0248-6016"/>
