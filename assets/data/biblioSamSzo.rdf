        <dc:title>Hymne de l'univers</dc:title>
        <dc:date>1997-03-29</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-02-020135-6</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2885">
        <rdf:value>&lt;p&gt;&quot;Une collectivité harmonisée des consciences, équivalente à une sorte de super-conscience, la Terre non seulement se couvrant de grains de pensée par myriades, mais enveloppant d'une seule enveloppe pensante, jusqu'à ne plus former fonctionnellement qu'un seul vaste Grain de Pensée, à l'échelle sidérale. La pluralité des réflexions individuelles se groupant et se renforçant dans l'acte d'une seule Réflexion unanime.&quot; p. 203&lt;/p&gt;</rdf:value>
        <dc:subject>noosphère</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
    </bib:Memo>
