    <bib:Memo rdf:about="#item_2725">
        <rdf:value>&lt;p&gt;&quot;L'un des premiers problèmes qui se posent à ceux qui ambitionnent d'appliquer leurs théories à des problèmes humains, est celui de la formation des hommes qui seront chargés d'exécuter les plans.&quot; p. 310&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:BookSection rdf:about="#item_336">
        <z:itemType>bookSection</z:itemType>
