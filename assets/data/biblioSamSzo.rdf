    <bib:Thesis rdf:about="https://tel.archives-ouvertes.fr/tel-02615456">
        <z:itemType>thesis</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Université de Technologie de Compiègne</foaf:name>
            </foaf:Organization>
