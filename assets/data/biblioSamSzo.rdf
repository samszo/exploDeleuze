        <dc:title>Enjeux et technologies : des données au sens</dc:title>
        <dc:date>2011-12-01</dc:date>
        <z:language>fr</z:language>
        <z:shortTitle>Enjeux et technologies</z:shortTitle>
        <z:libraryCatalog>www.cairn.info</z:libraryCatalog>
