        <dc:title>Une unité sacrée : quelques pas de plus vers une écologie de l'esprit</dc:title>
        <dc:date>1996</dc:date>
        <dc:subject>
           <dcterms:LCC><rdf:value>0039</rdf:value></dcterms:LCC>
        </dc:subject>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>http://catalogue.bnf.fr/servlet/biblio?ID=41207560&amp;SN1=0&amp;SN2=0&amp;idNoeud=1.1.1.1.1.1.1&amp;FormatAffichage=1&amp;host=catalogue</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2010-04-22 05:37:59</dcterms:dateSubmitted>
        <dc:rights>Catalogue en ligne de la Bibliothèque nationale de France</dc:rights>
        <dc:description>Collection : Points ; 594</dc:description>
        <dc:identifier>ISBN 2-02-018367-6</dc:identifier>
        <prism:edition>Éd. du Seuil</prism:edition>
    </bib:Book>
    <bib:Memo rdf:about="#item_2675">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P.sdfootnote-western { margin-left: 0.5cm; text-indent: -0.5cm; margin-bottom: 0cm; font-size: 9pt; text-align: justify } 		P.sdfootnote-cjk { margin-left: 0.5cm; text-indent: -0.5cm; margin-bottom: 0cm; font-size: 9pt; text-align: justify } 		P.sdfootnote-ctl { margin-left: 0.5cm; text-indent: -0.5cm; margin-bottom: 0cm; font-size: 10pt; text-align: justify } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p&gt;«&amp;nbsp;ce dont je veux parler , plus ou moins, c'est du genre de chose qui se passent dans la tête de quelqu'un, dans son comportement et dans ses interactions avec d'autres personnes, lorsqu'il escalade ou descend une montagne, lorsqu'il tombe malade ou lorsqu'il va mieux. Toutes ces choses s'entremêlent et forment un réseau qui, dans le jargon local, s'appelle un mandala. Je suis plus à l'aise avec le mot &quot;écologie&quot; mais ce sont des idées qui se recouvrent fort.&lt;span lang=&quot;fr-FR&quot;&gt;»&lt;/span&gt; p. 354&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
        <dc:subject>écologie</dc:subject>
        <dc:subject>esprit</dc:subject>
        <dc:subject>mandala</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2676">
        <rdf:value>&lt;p&gt;&quot;Et il s'avère que la métaphore n'est pas seulement de la belle poésie, ni même de la bonne ou de la mauvaise logique, c'est la logique sur laquelle le monde biologique est construit, c'est la caractéristique principale et le principe organisateur de ce monde des processus mentaux que j'ai tenté d'esquisser pour vous. &quot; p. 327&lt;/p&gt;</rdf:value>
        <dc:subject>métaphore</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>logique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2674">
        <rdf:value>&lt;p&gt;&quot;Les idées meurent parce qu'elles ne s'ajustent pas aux autres.&quot; p. 354&lt;/p&gt;</rdf:value>
        <dc:subject>Spinoza</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>mort</dc:subject>
        <dc:subject>idée</dc:subject>
    </bib:Memo>
