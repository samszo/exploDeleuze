        <dc:title>Protovis: A graphical toolkit for visualization</dc:title>
        <dc:date>2009</dc:date>
        <z:shortTitle>Protovis</z:shortTitle>
        <z:libraryCatalog>Google Scholar</z:libraryCatalog>
        <bib:pages>1121–1128</bib:pages>
    </bib:Article>
    <bib:Memo rdf:about="#item_2963">
        <rdf:value>&lt;p&gt;&quot;For the purpose of comparison we divide tools used to visualize data into two categories: visualization systems based on high-level abstractions tailored to data visualization, and graphical systems using only low-level graphical primitives.&quot; p. 1&lt;/p&gt;</rdf:value>
        <dc:subject>design</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>typologie</dc:subject>
        <dc:subject>outil</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2549">
        <rdf:value>&lt;p&gt;&quot;Marks are associated with data: a mark is generated once per associated datum, mapping the datum to visual properties such as position and color.&quot; p. 2&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbole</dc:subject>
        <dc:subject>fait</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2550">
        <rdf:value>&lt;p&gt;&quot;Thus we attempted to minimize the number of&lt;br /&gt;intervening abstractions, allowing designers to focus on the composition of data-representative graphic elements using a notation that is concise and easy to learn.&quot; p. 2&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>credo</dc:subject>
    </bib:Memo>
    <bib:Book rdf:about="#item_303">
        <z:itemType>book</z:itemType>
        <dc:publisher>
           <foaf:Organization><foaf:name>Macmillan</foaf:name></foaf:Organization>
