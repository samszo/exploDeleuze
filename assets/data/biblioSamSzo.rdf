    <bib:Thesis rdf:about="https://hal-emse.ccsd.cnrs.fr/tel-01157944">
        <z:itemType>thesis</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <foaf:name>Université Jean Monnet de Saint-Etienne ; Ecole des Mines de Saint-Etienne</foaf:name>
