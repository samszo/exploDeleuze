            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2932"/>
        <dcterms:isReferencedBy rdf:resource="#item_1865"/>
        <dc:title>L'arbre, le labyrinthe et l'océan. Les métaphores du savoir, des Lumières au numérique</dc:title>
        <dc:date>2004</dc:date>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>http://www.persee.fr/web/revues/home/prescript/article/colan_0336-1500_2004_num_139_1_3260</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <bib:pages>101-110</bib:pages>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:0336-1500">
        <prism:volume>139</prism:volume>
        <dc:title>Communication et langages</dc:title>
        <dc:identifier>DOI 10.3406/colan.2004.3260</dc:identifier>
        <prism:number>1</prism:number>
        <dcterms:alternative>colan</dcterms:alternative>
        <dc:identifier>ISSN 0336-1500</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_2932">
        <rdf:value>&lt;p&gt;&quot;En parallèle à cette métaphorisation textuelle, de nombreuse représentations de l'Internet et de la toile ont été imaginées dès le début des années quatre-vingt-dix pour amener l'internaute à construire une représentation mentale de l'univers dans lequel il se déplaçait.&quot; p. 104&lt;/p&gt;</rdf:value>
        <dc:subject>métaphore</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>internet</dc:subject>
        <dc:subject>mental</dc:subject>
        <dc:subject>réprésentation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1865">
        <rdf:value>&lt;p&gt;&quot;La nature même de l'hypertexte efface les notions de début et de fin, de centre ou d'un principe organisateur au sein d'une structure en réseau. Le sens, tout comme dans la pensée moderne, est devenu une notion incertaine et subjective, à la charge de chaque internaute qui doit tracer individuellement son chemin.&quot; p. 105&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>hypertexte</dc:subject>
        <dc:subject>gordien</dc:subject>
        <dc:subject>chemin</dc:subject>
    </bib:Memo>
