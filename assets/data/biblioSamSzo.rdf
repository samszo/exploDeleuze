        <dcterms:isReferencedBy rdf:resource="#item_2815"/>
        <link:link rdf:resource="#item_1960"/>
        <dc:title>Explicatio Fabularum : la place de l'allégorie dans l'interprétation stoïcienne de la mythologie</dc:title>
        <dc:date>2005-04-26</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0004</rdf:value></dcterms:LCC>
        </dc:subject>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2815">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;L'allégorie est d'abord ce que la rhétorique traditionnelle postérieure aux anciens stoïciens appelle un trope, c'est-à-dire un procédé stylistique différent de la figure. Le trope consiste à prendre un mot ou une phrase dans un sens différent de son sens propre pour lui conférer un autre sens.&quot; p. 12&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
        <dc:subject>Quintilien</dc:subject>
    </bib:Memo>
