        <dcterms:isReferencedBy rdf:resource="#item_2812"/>
        <dc:title>Réflexions de Tertullien sur l'allégorie</dc:title>
        <dc:date>2005-04-26</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2812">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;... quels sont les critères permettant d'assurer que l'on est en présence d'une allégorie ? Le premier n'est certes pas propre à notre auteur, c'est l'absurdité, au moins apparente, du sens littéral.&quot; p. 139&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>connerie</dc:subject>
    </bib:Memo>
    <bib:BookSection rdf:about="#item_501">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dc:identifier>ISBN 2-7116-1762-9</dc:identifier>
                <dc:title>Allégorie des poètes Allégorie des philosophes : Etudes sur la poétique et l'herméneutique de l'allégorie de l'Antiquité à la Réforme</dc:title>
            </bib:Book>
        </dcterms:isPartOf>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Librairie Philosophique Vrin</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Fishbane</foaf:surname>
                        <foaf:givenName>Michel</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2798"/>
        <dcterms:isReferencedBy rdf:resource="#item_2813"/>
        <dcterms:isReferencedBy rdf:resource="#item_2800"/>
        <dcterms:isReferencedBy rdf:resource="#item_2799"/>
        <dc:title>L'allégorie dans la pensée, la littérature et la mentalité juive.</dc:title>
        <dc:date>2005-04-26</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2798">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;... l'allégorie est un exercice de purification de l'intellect par le dévoilement de vérités philosophiques cachées dans les récits et les paroles&quot; p. 110&lt;/p&gt;</rdf:value>
        <dc:subject>philosophie</dc:subject>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2813">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;... l'allégorie est un type particulièrement raffiné d'exercice spirituel, qui reprend à son compte l'objectif plus large d'affiner la connaissance que l'on a de ce monde et le flux des formes extérieures en vue de percevoir les vérités éternelles&quot; p. 110&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2800">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;... l'allégorie implique en quelque sorte une pensée de l'ambivalence : il s'agit de penser au-delà, à travers ou même en dépit du signifié proposé initialement au lecteur, de telle façon qu'un autre ou d'autres niveaux de signification viennent à son esprit.&quot; p. 89&lt;/p&gt;</rdf:value>
        <dc:subject>fonctionnement</dc:subject>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2799">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;Nous pouvons dire paradoxalement que le sens de l'allégorie subvertit un texte qui semble se suffire à lui-même et, par là met en question le caractère satisfaisant des apparences. Pour les tenants de l'allégorie, cette subversion est le début de la sagesse.&quot; p.90&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>sagesse</dc:subject>
    </bib:Memo>
