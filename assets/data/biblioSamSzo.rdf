    <bib:Article rdf:about="#item_471">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <dcterms:isPartOf>
                    <bib:Series>
                        <dcterms:alternative>Les dossiers du programme Modélisation de la complexité</dcterms:alternative>
                    </bib:Series>
                </dcterms:isPartOf>
                <dc:title>Aix en Provence</dc:title>
                <prism:number>Les sciences de la conception sont-elles enonçable et enseignables ?</prism:number>
                <dcterms:alternative>Dossier MCX XII</dcterms:alternative>
            </bib:Journal>
        </dcterms:isPartOf>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Findeli</foaf:surname>
                        <foaf:givenName>Alain</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_3326"/>
        <dcterms:isReferencedBy rdf:resource="#item_3327"/>
        <dcterms:isReferencedBy rdf:resource="#item_3328"/>
        <dc:title>Une boussole pour s'orienter dans l'espace épistémologique, éthique et esthétique du projet de conception</dc:title>
        <dc:date>Mai 1997</dc:date>
    </bib:Article>
    <bib:Memo rdf:about="#item_3326">
        <rdf:value>&lt;p&gt;&quot;comme toute métaphore ou analogie, celle de la boussole a ses limites. Alors une boussole de topographie indique &quot;objectivement&quot; le nord, la boussole du projet est entièrement &quot;habitée&quot; par son utilisateur : c'est lui qui se trouve à l'intersection des trois axes et non pas un point 0 &quot;théorique&quot;, car c'est lui, selon les trois instances de sa raison, s'engage expérientiellement dans chacune des décisions et subit existentiellement les tensions engendrées par la polarités constitutives du système.&quot; p. 180&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>point de vu</dc:subject>
        <dc:subject>boussole</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3327">
        <rdf:value>&lt;p&gt;&quot;il s'agit pour l'étudiant d'être bien au clair, par exemple, sur les valeurs et les objectifs qui motivent telle décision&quot; p. 180&lt;/p&gt;</rdf:value>
        <dc:subject>apprentissage</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3328">
        <rdf:value>&lt;p&gt;&quot;la raison humaine est susceptible de se déployer selon trois instances principales : le jugement théorique, le jugement pratique, ke jugement de goût. Elles forment les trois dimensions ou axes de la boussole : la dimension logique (épistémo- et méthodologique), la dimension éthique et la dimension esthétique.&quot; p.179&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>épistémologie</dc:subject>
        <dc:subject>boussole</dc:subject>
    </bib:Memo>
