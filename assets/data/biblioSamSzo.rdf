    <bib:Article rdf:about="http://sites.uclouvain.be/rec/index.php/rec/article/view/7784">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
                <prism:volume>33</prism:volume>
                <dc:title>Recherches en Communication</dc:title>
                <prism:number>33</prism:number>
