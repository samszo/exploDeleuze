    <bib:Memo rdf:about="#item_4068">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%2C%22type%22%3A%22article-journal%22%2C%22container-title%22%3A%22Revue%20des%20Interactions%20Humaines%20M%C3%A9diatis%C3%A9es%20(RIHM)%20%3D%20Journal%20of%20Human%20Mediated%20Interactions%22%2C%22issue%22%3A%221%22%2C%22note%22%3A%22publisher%3A%20Europia%22%2C%22page%22%3A%221-28%22%2C%22source%22%3A%22HAL%20Archives%20Ouvertes%22%2C%22title%22%3A%22Infologie%20et%20design%20informationnel.%20Une%20cartographie%20du%20domaine%22%2C%22URL%22%3A%22https%3A%2F%2Fhal.archives-ouvertes.fr%2Fhal-03540314%22%2C%22volume%22%3A%2221%22%2C%22author%22%3A%5B%7B%22family%22%3A%22Leleu-Merviel%22%2C%22given%22%3A%22Sylvie%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222022%22%2C3%2C20%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222020%22%2C6%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;6&quot;&gt;&lt;h1&gt;Annotations&lt;br/&gt;(20/03/2022 à 07:31:15)&lt;/h1&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FDI2ZY5EQ%22%2C%22annotationKey%22%3A%22XDSFXZLA%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%222%22%2C%22position%22%3A%7B%22pageIndex%22%3A2%2C%22rects%22%3A%5B%5B274.804%2C396.847%2C382.803%2C408.187%5D%2C%5B56.64%2C385.807%2C382.904%2C397.147%5D%2C%5B56.64%2C374.767%2C161.234%2C386.107%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%222%22%7D%7D&quot;&gt;« Il convient donc de prêter attention aux questions concernant la production, la transmission et la perception des messages verbo-visuels »&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%222%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Leleu-Merviel, 2020, p. 2&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;img data-attachment-key=&quot;BA2NDDFF&quot; width=&quot;548&quot; height=&quot;339&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FDI2ZY5EQ%22%2C%22annotationKey%22%3A%22RWTI86BE%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%223%22%2C%22position%22%3A%7B%22pageIndex%22%3A3%2C%22rects%22%3A%5B%5B67.619%2C354.713%2C396.332%2C558.352%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%223%22%7D%7D&quot;/&gt;&lt;br/&gt;&lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%223%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Leleu-Merviel, 2020, p. 3&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;img data-attachment-key=&quot;M2PWVJC2&quot; width=&quot;562&quot; height=&quot;520&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FDI2ZY5EQ%22%2C%22annotationKey%22%3A%22YA9VU4MF%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%224%22%2C%22position%22%3A%7B%22pageIndex%22%3A4%2C%22rects%22%3A%5B%5B53.077%2C289.146%2C390%2C600.685%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%224%22%7D%7D&quot;/&gt;&lt;br/&gt;&lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%224%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Leleu-Merviel, 2020, p. 4&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FDI2ZY5EQ%22%2C%22annotationKey%22%3A%2265IV56LF%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%2220%22%2C%22position%22%3A%7B%22pageIndex%22%3A20%2C%22rects%22%3A%5B%5B110.4%2C480.127%2C382.571%2C491.467%5D%2C%5B56.64%2C469.087%2C382.877%2C480.427%5D%2C%5B56.64%2C458.047%2C382.883%2C469.387%5D%2C%5B56.64%2C447.007%2C382.605%2C458.347%5D%2C%5B56.64%2C436.207%2C320.607%2C447.547%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2220%22%7D%7D&quot;&gt;« Le dispositif, on le sait, a été introduit par Michel Foucault (1975) qui le définit comme un réseau composé par « des discours, des institutions, des aménagements architecturaux, des décisions réglementaires, des lois, des mesures administratives, des énoncés scientifiques, des propositions philosophiques, morales, philanthropiques, bref : du dit aussi bien que du non-dit ». »&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2220%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Leleu-Merviel, 2020, p. 20&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FDI2ZY5EQ%22%2C%22annotationKey%22%3A%226BDMLZMA%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%2222%22%2C%22position%22%3A%7B%22pageIndex%22%3A22%2C%22rects%22%3A%5B%5B137.04%2C253.807%2C382.906%2C265.147%5D%2C%5B56.64%2C242.767%2C382.865%2C254.107%5D%2C%5B56.64%2C231.967%2C382.624%2C243.307%5D%2C%5B56.64%2C220.927%2C95.432%2C232.267%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2222%22%7D%7D&quot;&gt;« Ces multiples dimensions dessinent les contours d’une « raison médiatique », dans le prolongement de la raison graphique de Jack Goody (1979) et de la raison computationnelle de Bruno Bachimont (2004) qu’elle tisse et tresse ensemble. »&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2222%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Leleu-Merviel, 2020, p. 22&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FDI2ZY5EQ%22%2C%22annotationKey%22%3A%22V4M7FN6B%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%2224%22%2C%22position%22%3A%7B%22pageIndex%22%3A24%2C%22rects%22%3A%5B%5B76.56%2C306.847%2C382.444%2C318.187%5D%2C%5B56.64%2C295.807%2C382.392%2C307.147%5D%2C%5B56.64%2C284.767%2C339.605%2C296.107%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2224%22%7D%7D&quot;&gt;« Le design médiatique est entendu comme la conception et la réalisation de dispositifs médiatiques, au sens large : techniques, institutions, règlements, lois, normes, matérialités et architectures des lieux et des objets, médias... »&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2224%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Leleu-Merviel, 2020, p. 24&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FDI2ZY5EQ%22%2C%22annotationKey%22%3A%226XAUVE8W%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%2224%22%2C%22position%22%3A%7B%22pageIndex%22%3A24%2C%22rects%22%3A%5B%5B343.925%2C284.767%2C382.906%2C296.107%5D%2C%5B56.64%2C273.727%2C382.683%2C285.067%5D%2C%5B56.64%2C262.687%2C382.636%2C274.027%5D%2C%5B56.64%2C251.647%2C382.722%2C262.987%5D%2C%5B56.64%2C240.847%2C382.625%2C252.187%5D%2C%5B56.64%2C229.807%2C382.881%2C241.147%5D%2C%5B56.64%2C218.767%2C194.207%2C230.107%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2224%22%7D%7D&quot;&gt;« Le design informationnel est un sous-ensemble du design médiatique, qui comprend la mise en forme des données, des représentations, des tracés, des croquis, des dessins, des énoncés, des discours, des formulations, des mises en images et en sons (éventuellement en parfums, en goûts ou en touchers), des graphiques et graphismes, des montages audiovisuels, des concrétisations, des réalisations, des fabrications... au sein du dispositif. »&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2224%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Leleu-Merviel, 2020, p. 24&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FDI2ZY5EQ%22%2C%22annotationKey%22%3A%22QPKR6DZ9%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%2224%22%2C%22position%22%3A%7B%22pageIndex%22%3A24%2C%22rects%22%3A%5B%5B76.56%2C163.807%2C382.905%2C175.147%5D%2C%5B56.64%2C152.767%2C382.688%2C164.107%5D%2C%5B56.64%2C141.727%2C342.96%2C153.067%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2224%22%7D%7D&quot;&gt;« L’infologie, infology, est la science de l’information et de la communication hyper et pluri médiatiques ou encore, de manière explicitement détaillée, la science des (hyper)médiations visuelles, sonores, gustatives, olfactives et tactiles. »&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2FGDNYJ4AS%22%5D%2C%22locator%22%3A%2224%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;Leleu-Merviel, 2020, p. 24&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</rdf:value>
    </bib:Memo>
