               <rdf:value>http://www.amazon.fr/dp/2130574491</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2010-09-30 07:20:41</dcterms:dateSubmitted>
        <z:linkMode>3</z:linkMode>
        <link:type>text/html</link:type>
    </z:Attachment>
    <bib:Book rdf:about="urn:isbn:2-253-94197-2">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>LGF - Livre de Poche</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Bachelard</foaf:surname>
                        <foaf:givenName>Gaston</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_3401"/>
        <dcterms:isReferencedBy rdf:resource="#item_3398"/>
        <dcterms:isReferencedBy rdf:resource="#item_3399"/>
        <dcterms:isReferencedBy rdf:resource="#item_2547"/>
        <dcterms:isReferencedBy rdf:resource="#item_3400"/>
        <link:link rdf:resource="#item_2063"/>
        <dc:title>L'intuition de l'instant</dc:title>
        <dc:date>1994-09-01</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-253-94197-2</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_3401">
        <rdf:value>&lt;p&gt;&quot;Ce qui persiste, c'est toujours ce qui se régénère.&quot; p. 83&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>génératif</dc:subject>
        <dc:subject>persistence</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3398">
        <rdf:value>&lt;p&gt;&quot;dans chacun de nos actes, dans le moindre de nos gestes on pourrait donc saisir le caractère achevé de ce qui s'ébauche, la fin dans le commencement, l'être et tout son devenir dans l'élan du germe.&quot; p. 18&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>graine</dc:subject>
        <dc:subject>geste</dc:subject>
        <dc:subject>acte</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3399">
        <rdf:value>&lt;p&gt;&quot;Il n'y a que la paresse qui soit durable, l'acte est instantané.&quot; p. 23&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>instant</dc:subject>
        <dc:subject>paresse</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2547">
        <rdf:value>&lt;p&gt;&lt;span style=&quot;font-family: arial; font-size: small;&quot;&gt;&quot;Le courage intellectuel, c'est de garder actif et vivant cet instant de la connaissance naissante, d'en faire la source sans cesse jaillissante de notre intuition, et de&amp;nbsp;dessiner, avec l'histoire subjective de nos erreurs et de nos fautes, le modèle objectif d'une vie meilleure et plus claire.&quot; p. 6&lt;/span&gt;&lt;/p&gt;</rdf:value>
        <dc:subject>objectif</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>dessiner</dc:subject>
        <dc:subject>subjectif</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3400">
        <rdf:value>&lt;p&gt;&quot;Le sens et la portée de l'avenir sont inscrit dans le présent même.&quot; p. 51&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>avenir</dc:subject>
        <dc:subject>présent</dc:subject>
    </bib:Memo>
