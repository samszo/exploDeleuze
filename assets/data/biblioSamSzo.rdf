        <z:linkMode>3</z:linkMode>
        <link:type>text/html</link:type>
    </z:Attachment>
    <bib:BookSection rdf:about="#item_631">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dc:identifier>ISBN 2-7555-0075-1</dc:identifier>
                <dc:title>Le design de nos existences : A l'époque de l'innovation ascendante</dc:title>
            </bib:Book>
        </dcterms:isPartOf>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Mille et une Nuits</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Boutang</foaf:surname>
                        <foaf:givenName>Yann Moulier</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2045"/>
        <dcterms:isReferencedBy rdf:resource="#item_2529"/>
        <dcterms:isReferencedBy rdf:resource="#item_2528"/>
        <dcterms:isReferencedBy rdf:resource="#item_2044"/>
        <dcterms:isReferencedBy rdf:resource="#item_2530"/>
        <dc:title>Du design capitalisme au capitalisme cognitif</dc:title>
        <dc:date>2008-10-08</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2045">
        <rdf:value>&lt;p&gt;c'est le cas de tout système symbolique ! de toutes physicalités bien que nécessaire n'en est pas moins productrice d'idées inadéquates...&lt;/p&gt;</rdf:value>
        <dc:relation rdf:resource="#item_2529"/>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2529">
        <rdf:value>&lt;p&gt;&quot;Ce que révèle le numérique et la bêtise tenace des ordinateurs, c'est l'intelligence nue, pure, comme capacité d'apporter des réponses nouvelles à des questions non prévues et non des solutions qui n'aient pas été pré-programmées.&quot; p. 52&lt;/p&gt;</rdf:value>
        <dc:relation rdf:resource="#item_2045"/>
        <dc:subject>citation</dc:subject>
        <dc:subject>bêtise</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2528">
        <rdf:value>&lt;p&gt;&quot;L'utilité comme le prix économique des abeilles tiennent beaucoup plus à la pollinisation des plantes, et particulièrement des fruits et légumes, qu'à leur production de miel (le rapport est de 350 fois à 1)&quot; p. 55&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>abeille</dc:subject>
        <dc:subject>productivité</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2044">
        <rdf:value>&lt;p&gt;&quot;Le sociologue américain Richard Florida et l'économiste Eric von Hippel du MIT, qui mettent fortement en question la structuration verticale, soulignent tous deux que les systèmes productifs innovants sont ceux qui sont organisés en rhizomes, faisant des réseaux provignants à l'infini (comme le marcotage végétal) et qui sont ascendant (&lt;em&gt;bottom up&lt;/em&gt;) et pas descendants (&lt;em&gt;top down&lt;/em&gt;).&quot; p. 56&lt;/p&gt;</rdf:value>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2530">
        <rdf:value>&lt;p&gt;&quot;Par immatériel de niveau 1 ou immatériel 1, on entendra un processus d'incorporation du cognitif et des savoirs dans la production matérielle accompagnée de l'émission de droits de propriété sur des supports codifiés (brevets, droits d'auteurs et marques). Par immatériel de niveau 2 ou immatériel 2, on entendra ce qui entoure l'immatériel 1, son halo, qui est la clé d'un processus plus délicat et plus complexe de subordination de la production matérielle à des dispositifs de captation de l'innovation.&quot; p. 51&lt;/p&gt;</rdf:value>
        <dc:relation rdf:resource="urn:isbn:2-7071-6009-1"/>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
        <dc:subject>immatériel</dc:subject>
    </bib:Memo>
    <bib:Book rdf:about="urn:isbn:2-7462-1395-8">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Hermes Science Publications</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Jussien</foaf:surname>
                        <foaf:givenName>Narendra</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2844"/>
        <dcterms:isReferencedBy rdf:resource="#item_2843"/>
        <dcterms:isReferencedBy rdf:resource="#item_2845"/>
        <dcterms:isReferencedBy rdf:resource="#item_2907"/>
        <dcterms:isReferencedBy rdf:resource="#item_2842"/>
        <link:link rdf:resource="#item_1986"/>
        <dc:title>Logique(s), langages formels et complexité pour l'informatique</dc:title>
        <dc:date>2006-09-30</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
        <dc:identifier>ISBN 2-7462-1395-8</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2844">
        <rdf:value>&lt;p&gt;&quot;Ce qui est premier dans le calcul mathématique n'est pas l'interprétation qu'on donne aux symboles employés, à savoir la quantité, mais leurs relations et les lois qui régissent leur combinaison. C'est cette découverte qui fonde la logique mathématique moderne.&quot; p. 22&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>mathématique</dc:subject>
        <dc:subject>logique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2843">
        <rdf:value>&lt;p&gt;&quot;Introduire cette notion de relation (qu'elle soit unaire, binaire, ..., n-aire) c'est se donner les moyens de traiter celle de variable, c'est-à-dire de la place que viendra occuper tel ou tel objet dans un énoncé.&quot; p. 56&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>relation</dc:subject>
        <dc:subject>variable</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2845">
        <rdf:value>&lt;p&gt;&quot;la démarche de l'informaticien confronté à un problème est toujours la même :&lt;/p&gt;
&lt;p&gt;- trouver un équivalent discret et numérique aux données réelles du problèmes ;&lt;/p&gt;
&lt;p&gt;- exprimer sous forme d'algorithme les conditions de modifications de ces données permettent d'aboutir au résultat recherché&quot; p. 14&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>informatique</dc:subject>
        <dc:subject>processus</dc:subject>
        <dc:subject>problème</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2907">
        <rdf:value>&lt;p&gt;&quot;La forme symbolique d'un langage est vue comme une structure dans laquelle l'ensemble des unités lexicales est &quot;manipulé&quot; par une système de règles grammaticales (syntaxiques). Ainsi, la grammaire représente le mécanisme syntaxique qui assure la cohésion formelle (la cohésion de surface) des phrases.&quot; p. 116&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>cohérence</dc:subject>
        <dc:subject>symbolique</dc:subject>
        <dc:subject>grammaire</dc:subject>
        <dc:subject>langage</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2842">
        <rdf:value>&lt;p&gt;&quot;La partie de la logique qui utilise ces notions [variable, quantité] se nomme la logique du premier ordre, par opposition aux logiques d'ordre supérieur, comme celle du second ordre, dans lesquelles il est possible de quantifier également les relations et les fonctions.&quot; p. 56&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>logique</dc:subject>
        <dc:subject>ordre</dc:subject>
        <dc:subject>premier</dc:subject>
    </bib:Memo>
