        <dcterms:isReferencedBy rdf:resource="#item_2902"/>
        <link:link rdf:resource="#item_2414"/>
        <dc:title>Langage et pouvoir symbolique</dc:title>
        <dc:date>2001-09-04</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-02-050922-9</dc:identifier>
        <prism:edition>Ed. rev. et augm.</prism:edition>
    </bib:Book>
    <bib:Memo rdf:about="#item_2612">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;… on ne peut dépasser l'alternative des modèles énergétiques qui décrivent les relations sociales comme des rapport de force et des modèles cybernétiques qui en font des relations de communication, qu'à condition de décrire les lois de transformations qui régissent la transmutation des différentes espèces de capital symbolique et en particulier le travail de dissimulation et de transfiguration (en un mot, d'euphéminisation) qui assure une véritable transubstantiation des rapports de force en faisant méconnaitre-reconnaitre la violence qu'ils enferment objectivement et en les transformant ainsi en pouvoir symbolique, capable de produire des effets réels sans dépense apparente d'énergie.&amp;nbsp;» p. 210&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbole</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2903">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;… procédant, selon le vœu de Schelling, à une lecture proprement &lt;em&gt;tautégorique&lt;/em&gt; (par opposition à &lt;em&gt;allégorique&lt;/em&gt;) qui ne réfère le mythe à rien d'autre qu'à lui-même, l'analyse structurale vise à dégager la structure immanente à chaque production symbolique.&amp;nbsp;» p. 204&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbolique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2613">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;« Le pouvoir symbolique […] pouvoir quasi magique qui permet d'obtenir l'équivalent de ce qui est obtenu par la force (physique ou économique), grâce à l'effet spécifique de mobilisation, ne s'exerce que s'il est reconnu, c'est-à-dire méconnu comme arbitraire.&amp;nbsp;» p.210&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>pouvoir</dc:subject>
        <dc:subject>symbole</dc:subject>
        <dc:subject>magie</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2899">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;Le pouvoir symbolique est en effet ce pouvoir invisible qui ne peut s'exercer qu'avec la complicité de ceux qui ne veulent pas savoir qu'ils le subissent ou même qu'ils l'exercent.&amp;nbsp;» p. 202&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>pouvoir</dc:subject>
        <dc:subject>symbolique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2614">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;Le pouvoir symbolique est un pouvoir de construction de la réalité qui tend à établir un ordre gnoséologique : le sens immédiat du monde (et en particulier du monde social) suppose ce que Durkheim appelle le conformisme logique, c'est-à-dire «&amp;nbsp;une conception homogène du temps, de l'espace, du nombre, de la cause, qui rend l'accord possible entre les intelligences&amp;nbsp;» » p. 205&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>pouvoir</dc:subject>
        <dc:subject>symbole</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2625">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;Les symboles sont les instruments par excellence de l'«intégration sociale&amp;nbsp;» : en tant qu'instrument de connaissance et de communication […] ils rendent possible le consensus sur le sens du monde social qui contribue fondamentalement à la reproduction social ; l'intégration «&amp;nbsp;logique&amp;nbsp;» est la condition de l'intégration «&amp;nbsp;morale&amp;nbsp;» » p. 205&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>logique</dc:subject>
        <dc:subject>définition</dc:subject>
        <dc:subject>symbole</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2902">
        <rdf:value>&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;Les systèmes symboliques doivent leur force propre au fait que les rapports de force qui s'y expriment ne s'y manifestent que sous la forme méconnaissable de rapports de sens (déplacement)&amp;nbsp;»  P. 210&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbolique</dc:subject>
        <dc:subject>système</dc:subject>
    </bib:Memo>
