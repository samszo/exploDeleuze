            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Cazenave</foaf:surname>
                        <foaf:givenName>Catherine</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2482"/>
        <dc:title>Le coup de dé ou l'affirmation du hasard</dc:title>
        <dc:date>2006-05-20</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2482">
        <rdf:value>&lt;p&gt;« Pierre Boulez se réfère au poème de Mallarmé pour développer une conception &quot;labyrinthique&quot; de la composition musicale qui le conduit à défendre la notion de &quot;mobilité&quot; de l'oeuvre tout en soutenant l'idée de «&amp;nbsp;hasard dirigé&amp;nbsp;» pour parvenir à une complète négation du hasard qu'il nomme «&amp;nbsp;le hasard absorbé&amp;nbsp;» et qui garantit selon lui «&amp;nbsp;la sur puissance du compositeur&amp;nbsp;».&amp;nbsp;» p.&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>hasard</dc:subject>
        <dc:subject>pierre_boulez</dc:subject>
    </bib:Memo>
    <bib:Book rdf:about="urn:isbn:2-7186-0349-6">
        <z:itemType>book</z:itemType>
        <dc:publisher>
           <foaf:Organization><foaf:name>Galilée</foaf:name></foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Guattari</foaf:surname>
                        <foaf:givenName>Félix</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_1657"/>
        <dcterms:isReferencedBy rdf:resource="#item_4094"/>
        <dcterms:isReferencedBy rdf:resource="#item_4071"/>
        <dcterms:isReferencedBy rdf:resource="#item_4079"/>
        <dcterms:isReferencedBy rdf:resource="#item_4093"/>
        <link:link rdf:resource="#item_2025"/>
        <dc:relation rdf:resource="#item_3290"/>
        <dc:title>Cartographies schizoanalytiques</dc:title>
        <dc:date>1989-02-22</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-7186-0349-6</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_1657">
        <rdf:value>&lt;p&gt;&quot;... dans tous les registres des cribles se constituent en inter-face entre 1) les virtualit&amp;eacute;s virulentes du chaos, les prolif&amp;eacute;rations stochastiques et 2) les potentialit&amp;eacute;s actuelles d&amp;ucirc;ment r&amp;eacute;pertoriables et consolidables.&quot; p. 140&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>crible</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_4094">
        <rdf:value>&lt;p&gt;&quot;Ces&amp;nbsp; formes alternatives de r&amp;eacute;appropriation existentielle et d'autovalorisation peuvent devenir demain la raison de vie des collectivit&amp;eacute;s humaines et des individus qui refusent de s'abandonner &amp;agrave; l'entropie mortif&amp;egrave;re caract&amp;eacute;ristique de la p&amp;eacute;riode que nous traversons.&quot; p. 26&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>bulle</dc:subject>
        <dc:subject>existence</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_4071">
        <rdf:value>&lt;p&gt;&quot;Mais plutôt que de s'associer aux croisades à la mode contre les méfaits du modernisme, plutôt que de prêcher la réhabilitation des valeurs transcendantales en déroute ou de s'abandonner aux délices désabusés du post-modernisme, on peut tenter de récuser le dilemme du refus crispé ou de l'acceptation cynique de la situation.&quot; p. 9&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>critique</dc:subject>
        <dc:subject>post-modernité</dc:subject>
        <dc:subject>anti-modernité</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_4079">
        <rdf:value>&lt;p&gt;&quot;tous les systèmes de modélisation se valent, tous sont acceptables, mais uniquement dans la mesure où leurs principes d'intelligibilité renoncent à toute prétention universaliste et admettent qu'ils n'ont d'autre mission que de concourir à la cartographie de Territoires existentiels, - impliquant des Univers sensibles, cognitifs, affectifs, esthétiques, etc. - et cela, sur des aires et pour des périodes de temps bien délimités.&quot; p. 10&lt;/p&gt;</rdf:value>
        <dc:subject>cartographie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>modélisation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_4093">
        <rdf:value>&lt;p&gt;&quot;Toutes les d&amp;eacute;marches scientifiques, toutes les formes de rationalit&amp;eacute; logico-math&amp;eacute;matique, s'instaurent &amp;agrave; partir d'un m&amp;ecirc;me tissu de sch&amp;eacute;mas perceptifs, d'affects, d'activit&amp;eacute;s imaginaires et de repr&amp;eacute;sentation qu'on retrouve, par ailleurs, dans la vie quotidienne, le r&amp;ecirc;ve, la folie ou la cr&amp;eacute;ation. Seuls changent les Agencements et l'intensit&amp;eacute; des composantes mises en jeu.&quot; p. 51&lt;/p&gt;</rdf:value>
        <dc:subject>affect</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>science</dc:subject>
        <dc:subject>agencement</dc:subject>
    </bib:Memo>
