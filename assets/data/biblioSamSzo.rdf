        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2495"/>
        <dcterms:isReferencedBy rdf:resource="#item_2026"/>
        <dcterms:isReferencedBy rdf:resource="#item_2494"/>
        <dcterms:isReferencedBy rdf:resource="#item_2498"/>
        <dc:relation rdf:resource="#item_989"/>
        <dc:title>Introduction</dc:title>
        <dc:date>2010-04-21</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2495">
        <rdf:value>&lt;p&gt;&quot;Ces pratiques médiatisées se trouvent au centre de la transformation des &quot;écologies sociognitives&quot; &quot; p.19&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>écologie</dc:subject>
        <dc:subject>cognitif</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2026">
        <rdf:value>&lt;p&gt;encore et encore l'automatisation comme phantasme... l'homme libre est celui qui choisi ce qui le rend esclave...&lt;/p&gt;</rdf:value>
        <dc:relation rdf:resource="#item_2498"/>
        <dc:subject>commentaires</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2494">
        <rdf:value>&lt;p&gt;&quot;Gabriel Gallezot et Jean-Max Noyer évoquent des expérimentations en cours dans le domaine de l'édition numérique, expérmentations qui visent une meilleur mise en visibilité des dimensions processuelles et ouvertes des processus d'écriture, à travers ce que Michel Foucault appellait une &quot;édition de recherche&quot;. Une édition de recherche qui ferait apparaître &quot;le travail dans son mouvement, dans sa forme problématique. Un lieu où la recherche pourrait se présenter dans son caractère hypothétique et provisoire&quot;.&quot; p. 24&lt;/p&gt;</rdf:value>
        <dc:subject>jardin</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>john_cage</dc:subject>
        <dc:subject>michel_foucault</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2498">
        <rdf:value>&lt;p&gt;&quot;Selon eux [les auteurs], cela justifie pleinement l'attention que nous portons à l'évolution de la créativité et de l'innovation dans le domaine des technologies intellectuelles et en particulier de l'automatisation de tâches intellectuelles essentielles telles que le filtrage, la classification, la recherche ou l'indexation.&quot; p. 20&lt;/p&gt;</rdf:value>
        <dc:relation rdf:resource="#item_2026"/>
        <dc:subject>citation</dc:subject>
        <dc:subject>automatisation</dc:subject>
    </bib:Memo>
    <bib:Book rdf:about="#item_548">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Le courrier du livre</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                       <foaf:surname>Krishnamurti</foaf:surname>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2500"/>
        <link:link rdf:resource="#item_2028"/>
        <dc:title>De la connaissance de soi</dc:title>
        <dc:date>2007</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:Book>
    <bib:Memo rdf:about="#item_2500">
        <rdf:value>&lt;p&gt;&quot;la connaissance de soi est conscience du soi sans division ; et tant qu'il n'y a pas de connaissance de soi, la multiplication et la re-fabrication de nos problème continuera. Voilà pourquoi l'individu a une énorme valeur. Car il est le seul transformateur, lui seul peut provoquer une révolution dans ses rapports, et par conséquent une révolution dans le monde, dans le monde avec lequel il est en relation [...] cette transformation ne peut avoir lieu par aucun miracle, par aucune connaissance livresque, mais seulement par une continuelle expérimentation, par une continuelle découverte du processus de notre être.&quot; p. 74&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>expérimentation</dc:subject>
        <dc:subject>rapport</dc:subject>
    </bib:Memo>
