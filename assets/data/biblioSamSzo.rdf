            <dcterms:URI>
               <rdf:value>http://methodos.revues.org/3127</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2014-02-03 11:14:14</dcterms:dateSubmitted>
