        <dcterms:isReferencedBy rdf:resource="#item_2100"/>
        <dcterms:isReferencedBy rdf:resource="#item_2083"/>
        <dcterms:isReferencedBy rdf:resource="#item_2711"/>
        <dcterms:isReferencedBy rdf:resource="#item_2712"/>
        <dcterms:isReferencedBy rdf:resource="#item_2710"/>
        <dcterms:isReferencedBy rdf:resource="#item_2709"/>
        <dcterms:isReferencedBy rdf:resource="#item_2713"/>
        <dcterms:isReferencedBy rdf:resource="#item_2099"/>
        <dc:title>Instrument subjectif et développement du pouvoir d'agir</dc:title>
        <dc:date>2005</dc:date>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2100">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot; lang=&quot;fr-FR&quot;&gt;A comparer avec le cours de Deleuze sur : que peut le corps ?&lt;/p&gt;</rdf:value>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2083">
        <rdf:value>&lt;p&gt;j'ai l'impression qu'il néglige l'intériorité ????&lt;/p&gt;</rdf:value>
        <dc:subject>question</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2711">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot; lang=&quot;fr-FR&quot;&gt;«&amp;nbsp;L'agir [...] concerne au-delà du rapport à l'objet d'activité, les autres rapports constitutifs de l'action, rapport à soi, au autres, à la société via les diverses institutions dans lesquelles elle s'incarne. [...] L'agir s'étend ainsi à l'ensemble des dimensions de l'action normée et sensée.&amp;nbsp;» p. 18&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2712">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot; lang=&quot;fr-FR&quot;&gt;&quot;Le pouvoir d'agir dépend des conditions externes et internes au sujet, qui sont réunies à un moment particulier, comme l'état fonctionnel du sujet, artefacts et ressources disponibles, occasions d'interventions, etc. Il est toujours situé dans un rapport singulier au monde réel, rapport qui s'actualise et réalise la capacité d'agir en en transformant les potentialités en pouvoir.&quot; p. 19&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>pouvoir d'agir</dc:subject>
        <dc:subject>définition</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2710">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot; lang=&quot;fr-FR&quot;&gt;«&amp;nbsp;Le sujet capable se place d'abord du coté du &quot;je peux&quot; au double sens de &quot;je suis en capacité de&quot; et &quot;j'en ai la puissance&quot;, je le peux effectivement.&amp;nbsp;» p. 12&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2709">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot; lang=&quot;fr-FR&quot;&gt;«&amp;nbsp;Les genèses opératives contribuent ainsi à la dynamique évolutive des préconstruits sociaux par l'incorporation de certaines de leurs composantes dans les générations ultérieures d'artefacts et de schèmes sociaux mis en patrimoine au sein de systèmes d'ensembles eux-même socialement organisés comme les habitus, les genres ou les mondes partagés&amp;nbsp;» p. 26&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>mémétique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2713">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot; lang=&quot;fr-FR&quot;&gt;«&amp;nbsp;Pour le sujet capable (le sujet de capacité), l'activié cognitive est subordonnée et, d'une certaine façon, gouvernée par l'agir, alors que pour le sujet connaissant les rapports de subordination sont inverses : c'est l'agir qui est subordonné aux finalité cognitives&amp;nbsp;» p. 12&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>IN&lt;-&gt;OUT</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2099">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot; lang=&quot;fr-FR&quot;&gt;sa définition de l'agir construit une écologie cognitive : une structuration dynamique des relations&lt;/p&gt;</rdf:value>
    </bib:Memo>
