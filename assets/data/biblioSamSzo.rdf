        <dc:title>Dialogue sur la nature humaine</dc:title>
        <dc:date>2010-04-15</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
        <dc:identifier>ISBN 2-8159-0009-2</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2738">
        <rdf:value>&lt;p&gt;&quot;Le papillon n'est pas seulement prisonnier du contexte, il est prisonnier de son programme génétique. Cette façon d'être prisonnier lui donne en même temps le génie d'opérer sa métamorphose au sein de la chrysalide. A ce moment, une machine se met en marche : au lieu de le protéger, son système immunologique l'autodétruit. Mais dans cette autodestruction, il va naître papillon, c'est-à-dire le même mais autres...&quot; p.67&lt;/p&gt;</rdf:value>
        <dc:subject>machine</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>papillon</dc:subject>
    </bib:Memo>
