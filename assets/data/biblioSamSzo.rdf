    <bib:Book rdf:about="urn:isbn:2-00-002771-7">
        <z:itemType>book</z:itemType>
        <dc:publisher>
           <foaf:Organization><foaf:name>Omnibus</foaf:name></foaf:Organization>
        </dc:publisher>
