        <dc:subject>ergonomie</dc:subject>
        <dc:subject>conception</dc:subject>
        <dc:subject>point de vu</dc:subject>
        <dc:title>Analyse exploratoire de &quot;points de vue&quot; ? : une contribution pour outiller les processus de conception</dc:title>
        <dc:date>2005-09-01</dc:date>
        <z:language>fr</z:language>
        <z:shortTitle>Analyse exploratoire de “ points de vue �?</z:shortTitle>
        <z:libraryCatalog>accesdistant.bu.univ-paris8.fr:2056</z:libraryCatalog>
        <dc:identifier>
            <dcterms:URI>
                <rdf:value>http://www.cairn.info/article.php?ID_ARTICLE=TH_683_0253</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2013-10-06 08:42:01</dcterms:dateSubmitted>
        <dc:rights>© P.U.F.</dc:rights>
        <bib:pages>253-286</bib:pages>
    </bib:Article>
    <bib:Journal rdf:about="urn:issn:0041-1868">
        <prism:volume>Vol. 68</prism:volume>
        <dc:title>Le travail humain</dc:title>
        <dc:identifier>DOI 10.3917/th.683.0253</dc:identifier>
        <prism:number>3</prism:number>
        <dcterms:alternative>Le travail humain</dcterms:alternative>
        <dc:identifier>ISSN 0041-1868</dc:identifier>
    </bib:Journal>
    <bib:Memo rdf:about="#item_3178">
        <rdf:value>&lt;p&gt;&quot;D’une part, il s’agit de comprendre la valeur pragmatique de cette notion émergente dans le domaine de l’ergonomie des activités de conception, par rapport à d’autres notions telles que la notion de représentation. D’autre part, il s’agit de contribuer aux connaissances théoriques et méthodologiques concernant l’étude des processus individuels, voire collectifs, mis en œuvre dans la conception.&quot;&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>conception</dc:subject>
        <dc:subject>processus</dc:subject>
        <dc:subject>pragmatique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3179">
        <rdf:value>&lt;p&gt;&quot;L’analyse et la prise en compte des points de vue constituent un enjeu majeur pour la réussite des projets en facilitant la construction d’une «&amp;nbsp;représentation partagée&amp;nbsp;» du problème et des ressources pour sa solution. Le «&amp;nbsp;point de vue&amp;nbsp;» correspond ainsi à l’émergence d’un objet d’étude à la jonction de l’individuel et du collectif, de l’individuel et du social.&quot;&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>point de vu</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3180">
        <rdf:value>&lt;p&gt;&quot;Le «&amp;nbsp;point de vue&amp;nbsp;» se distinguerait des représentations mentales par au moins un aspect majeur&amp;nbsp;: c’est une «&amp;nbsp;opinion exprimée&amp;nbsp;» dans un temps et&amp;nbsp;un contexte donnés.&quot;&lt;/p&gt;</rdf:value>
        <dc:subject>point de vu</dc:subject>
        <dc:subject>expression</dc:subject>
        <dc:subject>opinion</dc:subject>
    </bib:Memo>
