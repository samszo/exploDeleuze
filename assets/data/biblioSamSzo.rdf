    <bib:Memo rdf:about="#item_2241">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } 		A:link { so-language: zxx } --&gt;
&lt;p&gt;Macro thésauri gouvernementaux :&lt;/p&gt;
&lt;p&gt;Eurovoc&lt;/p&gt;
&lt;p&gt;Thésaurus des sujets de base du gouvernement du Canada&lt;/p&gt;
