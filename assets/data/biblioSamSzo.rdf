        <dc:title>Métamodélisation pour le Web sémantique</dc:title>
        <dc:date>2008-12-01</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2950">
        <rdf:value>&lt;p&gt;&quot;Le Web sémantique nécessite la standardisation des mécanismes de représentation qui permettent à la connaissance contenue dans les page Web d'être identifiées et traitée au niveau sémantique.[...] Nous proposons dans cet article d'utiliser les graphes conceptuels comme langage pivot du Web.&quot; p. 85&lt;/p&gt;</rdf:value>
        <dc:subject>sémantique</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>Web</dc:subject>
        <dc:subject>langage</dc:subject>
        <dc:subject>pivot</dc:subject>
    </bib:Memo>
    <bib:BookSection rdf:about="#item_526">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dc:identifier>ISBN 2-85428-855-6</dc:identifier>
                <dc:title>Revue des nouvelles technologies de l'information</dc:title>
            </bib:Book>
        </dcterms:isPartOf>
        <dc:publisher>
           <foaf:Organization><foaf:name>Cépaduès</foaf:name></foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Fürst</foaf:surname>
                        <foaf:givenName>Frédéric</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Trichet</foaf:surname>
                        <foaf:givenName>Francky</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2260"/>
        <dc:title>Représenter, opérationnaliser, aligner et évaluer des Ontologies Dens : une approche et un outil fondés sur les modèle de Graphes Conceptuels</dc:title>
        <dc:date>2008-12-01</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2260">
        <rdf:value>&lt;p&gt;&quot;dans de nombreux contextes et en particulier dans le cadre du Web Sémantique dont le défi est d'offrir la possibilité d'automatiser la mise en oeuvre de raisonnements, il s'avère de plus en plus indispensable de considérer des &lt;em&gt;ontologies denses&lt;/em&gt;, &lt;em&gt;i. e.&lt;/em&gt; des ontologies intégrant l'ensemble des axiomes permettant de fixer toute la sémantique du domaine considéré, en comparaison aux &lt;em&gt;ontologies &lt;/em&gt;dites &lt;em&gt;légères &lt;/em&gt;qui, elles, n'incluent pas d'axiomes et sont uniquement fondées sur les hiérarchies de concepts et de relations&quot; p. 23&lt;/p&gt;</rdf:value>
        <dc:subject>sémantique</dc:subject>
        <dc:subject>Ontologie</dc:subject>
        <dc:subject>Web</dc:subject>
        <dc:subject>dense</dc:subject>
        <dc:subject>légère</dc:subject>
    </bib:Memo>
    <rdf:Description rdf:about="urn:isbn:2-85428-930-7">
        <z:itemType>conferencePaper</z:itemType>
        <dcterms:isPartOf>
            <bib:Journal>
               <dc:identifier>ISBN 2-85428-930-7</dc:identifier>
