                        <foaf:surname>Gobbo</foaf:surname>
                        <foaf:givenName>Federico</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Wagemans</foaf:surname>
                        <foaf:givenName>Jean H M</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
