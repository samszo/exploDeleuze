                    <foaf:Person>
                        <foaf:surname>Jung</foaf:surname>
                        <foaf:givenName>Carl Gustav</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2823"/>
        <dcterms:isReferencedBy rdf:resource="#item_2824"/>
        <dcterms:isReferencedBy rdf:resource="#item_2825"/>
        <dc:title>Paracelse</dc:title>
        <dc:date>1950</dc:date>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2823">
        <rdf:value>&lt;p&gt;&quot;&lt;span lang=&quot;fr-FR&quot;&gt;La nature n'est pas seulement le véhicule d'un processus de transformation, elle est elle-même transformation&lt;/span&gt;.&quot; p. 211&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>transformation</dc:subject>
        <dc:subject>nature</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2824">
        <rdf:value>&lt;p&gt;&quot;Paracelse demande : &quot; Qu'est-ce que la nature si ce n'est la philosophie ? &quot; Elle est dans l'homme et à l'extérieur. Elle est semblable à un miroir qui se composerait des quatre éléments, car les éléments reflètent le microcosme. On peut le connaître en connaissant sa &quot;mère&quot;, c'est-à-dire la &quot;&lt;em&gt;materia&lt;/em&gt;&quot; des éléments.&quot; p. 150&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
        <dc:subject>nature</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2825">
        <rdf:value>&lt;p&gt;&quot;Seules les choses extérieures donnent la connaissance de l'intérieur, rien d'intérieur ne saurait être connu autrement.&quot; cité p.143&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
        <dc:subject>IN&lt;-&gt;OUT</dc:subject>
    </bib:Memo>
    <bib:BookSection rdf:about="urn:isbn:2-7462-2361-9">
        <z:itemType>bookSection</z:itemType>
        <dcterms:isPartOf>
            <bib:Book>
                <dc:identifier>ISBN 2-7462-2361-9</dc:identifier>
                <dc:title>Technologies de l'information et intelligences collectives</dc:title>
            </bib:Book>
        </dcterms:isPartOf>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Hermes Science Publications</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Zacklad</foaf:surname>
                        <foaf:givenName>Manuel</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2877"/>
        <dcterms:isReferencedBy rdf:resource="#item_2931"/>
        <dc:relation rdf:resource="#item_989"/>
        <dc:title>Introduction aux appareils de capture sémantique dans les TIC et les SI</dc:title>
        <dc:date>2010-04-21</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_2877">
        <rdf:value>&lt;p&gt;&quot;Le refus des &quot;ontologues&quot; informaticiens de considérer les dimensions multiples de la signification, les condamnent à ne jamais pouvoir analyser correctement les usages qui sont fait de leurs formalismes, ceux-ci restant souvent, de ce fait, assez peu utiles.&quot; p. 187&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>Ontologie</dc:subject>
        <dc:subject>controverse</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2931">
        <rdf:value>&lt;p&gt;&quot;Les appareils de capture sémantique possèdent deux composants, l'un dédié à la description (écriture), l'autre à la recherche (lecture). Le premier est un dispositif d'aide à l'écriture codifiée (ou écriture automatique) qui contient notamment, dans le cas de la description manuelle, un langage de codification (ou système d'organisation des connaissances) et dans le cas d'une capture automatique, des algorithmes logiciels. [...] Le second est le dispositif d'aide à la recherche ou d'aide à la lecture, qui doit permettre d'accéder à la description préalablement réalisé des situations et des documents. Dans les dispositifs technologiques il offre d'une part, un système de &quot;requêtes&quot; et d'autres part, un système d'affichage de l'ensemble des résultats potentiellement pertinents.&quot; p. 190&lt;/p&gt;</rdf:value>
        <dc:subject>sémantique</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
        <dc:subject>appareil</dc:subject>
        <dc:subject>capture</dc:subject>
    </bib:Memo>
