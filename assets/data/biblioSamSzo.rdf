    <bib:Memo rdf:about="#item_1750">
        <rdf:value>&lt;p&gt;&quot;1. Le monde qui existe physiquement est décrit par une ontologie.&lt;br /&gt;2. Le monde des idées est décrit par une épistémologie.&lt;br /&gt;3. Une phénoménologie établit une correspondance entre une ontologie et une épistémologie.&quot; p.95&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>Ontologie</dc:subject>
        <dc:subject>épistémologir</dc:subject>
        <dc:subject>phénoménologie</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2697">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P.sdfootnote-western { margin-left: 0.5cm; text-indent: -0.5cm; margin-bottom: 0cm; font-size: 9pt; text-align: justify } 		P.sdfootnote-cjk { margin-left: 0.5cm; text-indent: -0.5cm; margin-bottom: 0cm; font-size: 9pt; text-align: justify } 		P.sdfootnote-ctl { margin-left: 0.5cm; text-indent: -0.5cm; margin-bottom: 0cm; font-size: 10pt; text-align: justify } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p&gt;&lt;span lang=&quot;fr-FR&quot;&gt;« &lt;/span&gt;Ce besoin de réflexion philosophique sur le calcul et de réflexion formelle sur la philosophie motive toute une activité de recherche fédérant philosophes et informaticiens.&lt;span lang=&quot;fr-FR&quot;&gt; » p. 90&lt;/span&gt;&lt;/p&gt;</rdf:value>
        <dc:subject>philosophie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>informatique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1827">
        <rdf:value>&lt;p&gt;&quot;Cette introduction du calcul dans notre monde est une chance formidable si elle sert à mieux réguler le système complexe qui nous constitue et dans lequel nous habitons.&quot; p. 92&lt;/p&gt;</rdf:value>
        <dc:relation rdf:resource="#item_2087"/>
        <dc:subject>citation</dc:subject>
        <dc:subject>calcul</dc:subject>
        <dc:subject>chance</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2696">
        <rdf:value>&lt;p&gt;&quot;Le système symbolique est un système déductif, cependant le mécanisme de preuve implique un partage de tâche selon une recherche collective.&quot; p. 93&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>symbole</dc:subject>
        <dc:subject>système</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2087">
        <rdf:value>&lt;p&gt;on ne peut réguler la complexité de notre univers mais par contre on peut se réguler soi-même. C'est un leurre de croire le contraire.&lt;/p&gt;</rdf:value>
        <dc:relation rdf:resource="#item_1827"/>
    </bib:Memo>
