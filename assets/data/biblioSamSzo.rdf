    <bib:Memo rdf:about="#item_1704">
        <rdf:value>&lt;p&gt;&quot;En fait, aucun travail ne peut être évité. Il peut-être indéfiniment reporté, mais pas infiniment. Pas plus que tout labeur d'une réelle importance ne peut être rendu plus facile par une coopération ou des machines. Il est impossible de s'épargner une seule once d'un travail sans l'avoir accompli.&quot; p. 33&lt;/p&gt;</rdf:value>
        <dc:subject>travail</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
