        <dc:title>Téléologie régnante et politique de modes</dc:title>
        <dc:date>2008</dc:date>
    </bib:BookSection>
    <bib:Memo rdf:about="#item_3249">
        <rdf:value>&lt;p&gt;&quot;En luttant activement contre l'invasion d'images et d'affects anti-rationnels occupant actuellement la médiasphère, il s'agirait donc d'ouvrir un espace capable d'accueillir les images des multitudes que nous formons, dès lors que nos automatisme mentaux ne sont pas empêchés de suivre leur cours par diverses armes de distraction massive.&quot; p.123&lt;/p&gt;</rdf:value>
        <dc:subject>information</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>lutte</dc:subject>
        <dc:subject>pollution</dc:subject>
    </bib:Memo>
