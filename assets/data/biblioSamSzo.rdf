        <dc:subject>A-LIRE</dc:subject>
        <dc:title>L'analogie : Coeur de la pensée</dc:title>
        <dc:date>2013</dc:date>
        <z:shortTitle>L'analogie</z:shortTitle>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:subject>
           <dcterms:LCC><rdf:value>0000</rdf:value></dcterms:LCC>
        </dc:subject>
        <dc:identifier>ISBN 2-7381-2473-9</dc:identifier>
        <z:numPages>685</z:numPages>
    </bib:Book>
    <bib:Memo rdf:about="#item_3841">
        <rdf:value>&lt;p&gt;&quot;...les catégories naissent petites, souvent à partir d'un seul exemplaire, puis noyaux et halos se développent : les catégories croissent en accueillant de nouveaux membres, parfois centraux, parfois périphériques. Pour les accueillr, il faut &quot;pousser les murs&quot; ou bien créer de nouvelles catégories. Le moteur de cette extension est l'analogie.&quot; p. 233&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>analogie</dc:subject>
        <dc:subject>catégorie</dc:subject>
        <dc:subject>moteur</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3163">
        <rdf:value>&lt;p&gt;&quot;A quel degré de généralité un proverbe s'applique-t-il ? Quelle est l'étendue des situations auxquelles un proverbe peut être attribué sans que cela semble exagéré, voir incongru ? [...] Où se trouvent finalement les frontières de la catégorie implicitement définie par notre proverbe ?&quot; p. 134&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>proverbe</dc:subject>
        <dc:subject>gapaii</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3843">
        <rdf:value>&lt;p&gt;&quot;D'un coté, nos conceptions dépendent de nos sens, car nos concepts seraient différents si notre appareil sensoriel était différent ; d'un autre côté, nos perceptions dépendent de nos concepts, car ceux-ci constituent les filtres à travers lesquels n'importe quel stimulus issu de notre environnement aboutit à notre conscience.&quot; p. 213&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>conception</dc:subject>
        <dc:subject>environnement</dc:subject>
        <dc:subject>perception</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_3842">
        <rdf:value>&lt;p&gt;&quot;Les situations sont formatées dans notre mémoire par nos concepts ; nous les percevons et les mémorisons à travers eux. Les évocations sont rendues possibles parce que certains aspects de la situation vécue ont été repérés et mémorisés lors de l'encodage initial de cette situation.&quot; p. 214&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>perception</dc:subject>
        <dc:subject>mémoire</dc:subject>
        <dc:subject>encodage</dc:subject>
