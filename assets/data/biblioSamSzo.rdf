                    <foaf:Person>
                        <foaf:surname>Deleuze</foaf:surname>
                        <foaf:givenName>Gilles</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2868"/>
        <dcterms:isReferencedBy rdf:resource="#item_2872"/>
        <dcterms:isReferencedBy rdf:resource="#item_2860"/>
        <dcterms:isReferencedBy rdf:resource="#item_2869"/>
        <dcterms:isReferencedBy rdf:resource="#item_2871"/>
