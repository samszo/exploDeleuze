                    <foaf:Person>
                        <foaf:surname>Mayere</foaf:surname>
                        <foaf:givenName>Anne</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2915"/>
