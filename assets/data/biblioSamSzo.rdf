        <dcterms:isReferencedBy rdf:resource="#item_1762"/>
        <dcterms:isReferencedBy rdf:resource="#item_2773"/>
        <dcterms:isReferencedBy rdf:resource="#item_2881"/>
        <dcterms:isReferencedBy rdf:resource="#item_2772"/>
        <link:link rdf:resource="#item_1941"/>
        <dc:title>Maître Eckhart: métaphysique du verbe et théologie négative</dc:title>
        <dc:date>1984</dc:date>
        <z:shortTitle>Maître Eckhart</z:shortTitle>
        <z:libraryCatalog>Google Books</z:libraryCatalog>
        <dc:identifier>ISBN 978-2-7010-1072-4</dc:identifier>
        <z:numPages>260</z:numPages>
    </bib:Book>
   <bib:Memo rdf:about="#item_1762"><rdf:value></rdf:value></bib:Memo>
    <bib:Memo rdf:about="#item_2773">
        <rdf:value>&lt;p&gt;&quot;La disjonction de l'être et de l'avoir exprime ainsi la rencontre, caractéristique chez Eckhart, du juridique et de l'ontologique.&quot; p. 88&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>avoir</dc:subject>
        <dc:subject>être</dc:subject>
        <dc:subject>juridique</dc:subject>
        <dc:subject>ontologique</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2881">
        <rdf:value>&lt;p&gt;&quot;la distinction des deux types de causalité [analogique et univoque] soit appliquée par Eckhart, tantôt pour définir la finitude ontologique de la créature en posant les conditions du labeur et de la patience nécessaire à son rétablissement, tantôt pour marquer la différence entre ce labeur lui-même et l'accomplissement qui le couronne&quot; p. 88&lt;/p&gt;</rdf:value>
        <dc:subject>travail</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>Ontologie</dc:subject>
        <dc:subject>univocité</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2772">
        <rdf:value>&lt;p&gt;&quot;Les deux genres différents de causalité [univoque et analogique] peuvent être illustrés par deux phénomènes pris dans la nature : la caléfaction de l'air et son illumination. La caléfaction de l'air se fait de partie à partie et partie par partie ; elle est donc successive et doté d'une extension temporelle [...] L'illumination de l'air, en revanche, est immédiate, chaque partie étant illuminée mais non pas illuminante pour la partie prochaine. [...] l'objet de l'action d'un agent univoque est toujours à la fois passif et actif dans toutes et chacune de ses parties. L'objet de l'agent analogique est purement passif et dans toutes ses parties. La qualité transportée n'y rencontre donc ni résistance ni concours.&quot; p. 85&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>analogie</dc:subject>
        <dc:subject>univocité</dc:subject>
        <dc:subject>causalité</dc:subject>
    </bib:Memo>
