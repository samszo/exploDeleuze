        <link:link rdf:resource="#item_3534"/>
        <dc:title>La modélisation des systèmes complexes</dc:title>
        <dcterms:abstract>Écrit pour tous ceux qui ont à gérer des «situations complexes», ce livre montre que la résolution des problèmes d'organisation passe davantage par le respect de la complexité du réel que par une amplification réductrice.</dcterms:abstract>
        <dc:date>15 juin 1999</dc:date>
        <z:language>Français</z:language>
        <z:libraryCatalog>Amazon</z:libraryCatalog>
        <dc:identifier>ISBN 978-2-10-004382-8</dc:identifier>
        <z:numPages>192</z:numPages>
    </bib:Book>
