    <bib:Book rdf:about="urn:isbn:978-2-07-029335-3">
        <z:itemType>book</z:itemType>
        <dc:publisher>
           <foaf:Organization><foaf:name>Gallimard</foaf:name></foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Foucault</foaf:surname>
                        <foaf:givenName>Michel</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2854"/>
        <dcterms:isReferencedBy rdf:resource="#item_3150"/>
        <dcterms:isReferencedBy rdf:resource="#item_3145"/>
