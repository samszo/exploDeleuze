    <bib:Memo rdf:about="#item_2945">
        <rdf:value>&lt;p&gt;&quot;Ce petit traité part de deux idées fondamentales. La première pose que la pensée fonctionne à l'aide d'un nombre fini de concepts-clés, lesquels peuvent être énumérés et élucidés. La seconde admet que ces concepts vont par paires, chacun possédant un &quot;contraire&quot; ni plus ni moins positif que lui-même.&quot; p. 9&lt;/p&gt;</rdf:value>
        <dc:subject>concept</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>miroir</dc:subject>
        <dc:subject>idée</dc:subject>
    </bib:Memo>
