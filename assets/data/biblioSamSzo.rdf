        <link:link rdf:resource="#item_2120"/>
        <dc:title>UNE CHAMBRE CONJECTURALE</dc:title>
        <dc:date>1981</dc:date>
        <z:libraryCatalog>Google Books</z:libraryCatalog>
        <z:numPages>96</z:numPages>
    </bib:Book>
    <bib:Memo rdf:about="#item_3405">
