    <bib:Article rdf:about="https://hal.archives-ouvertes.fr/hal-02123626">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf>
           <bib:Journal><dc:title>Semiotica</dc:title></bib:Journal>
        </dcterms:isPartOf>
        <bib:authors>
