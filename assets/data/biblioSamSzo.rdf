    <bib:Article rdf:about="http://www.cairn.info/article.php?ID_ARTICLE=TH_683_0253">
        <z:itemType>journalArticle</z:itemType>
        <dcterms:isPartOf rdf:resource="urn:issn:0041-1868"/>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
