        <link:link rdf:resource="#item_1753"/>
        <link:link rdf:resource="#item_1754"/>
        <dc:subject>A-LIRE</dc:subject>
        <dc:subject>
           <z:AutomaticTag><rdf:value>Logique</rdf:value></z:AutomaticTag>
        </dc:subject>
        <dc:subject>
            <z:AutomaticTag>
               <rdf:value>Lois de la nature</rdf:value>
            </z:AutomaticTag>
