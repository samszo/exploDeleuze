    <bib:Memo rdf:about="#item_1536">
        <rdf:value>&lt;div data-citation-items=&quot;%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22itemData%22%3A%7B%22id%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%2C%22type%22%3A%22article-journal%22%2C%22abstract%22%3A%22La%20pr%C3%A9sente%20contribution%20s%E2%80%99ins%C3%A8re%20dans%20un%20travail%20de%20plus%20grande%20envergure%2C%20visant%20%C3%A0%20mettre%20en%20lumi%C3%A8re%20les%20fondements%20naturels%20d%E2%80%99une%20th%C3%A9orie%20du%20sens.%20Dans%20une%20telle%20th%C3%A9orie%2C%20on%20distingue%20un%20double%20mouvement%20d%E2%80%99anas%C3%A9miose%20et%20de%20catas%C3%A9miose.%20C%E2%80%99est%20durant%20le%20premier%20que%20divers%20m%C3%A9canismes%20produisent%20le%20sens%2C%20sur%20la%20base%20des%20interactions%20entre%20les%20%C3%AAtres%20vivants%20et%20les%20stimulations%20provenant%20du%20monde.%20Nous%20nous%20focaliserons%20sur%20le%20second%20mouvement%2C%20au%20cours%20de%20laquelle%20le%20sens%20permet%20%E2%80%94%20voire%20produit%20%E2%80%94%20l%E2%80%99action%20sur%20le%20monde%20(jusques%20et%20y%20compris%20l%E2%80%99action%20mat%C3%A9rielle%20transformant%20ce%20dernier).%20Or%20il%20se%20fait%20que%20l%E2%80%99action%20sur%20le%20monde%20par%20les%20signes%2C%20vecteurs%20du%20sens%2C%20est%20le%20domaine%20d%E2%80%99%C3%A9tude%20de%20la%20pragmatique%20(apr%C3%A8s%20avoir%20%C3%A9t%C3%A9%20celui%20de%20la%20rh%C3%A9torique).%20Dans%20notre%20article%2C%20nous%20confronterons%20les%20conceptions%20classiques%20de%20la%20pragmatique%20et%20celles%20qui%20d%C3%A9coulent%20de%20notre%20approche%20physicaliste%20de%20la%20catas%C3%A9miose.%22%2C%22container-title%22%3A%22Corela.%20Cognition%2C%20repr%C3%A9sentation%2C%20langage%22%2C%22DOI%22%3A%2210.4000%2Fcorela.4540%22%2C%22ISSN%22%3A%221638-5748%22%2C%22issue%22%3A%22HS-19%22%2C%22language%22%3A%22fr%22%2C%22source%22%3A%22journals.openedition.org%22%2C%22title%22%3A%22Du%20sens%20%C3%A0%20l%E2%80%99action%2C%20de%20l%E2%80%99anas%C3%A9miose%20%C3%A0%20la%20catas%C3%A9miose%22%2C%22URL%22%3A%22http%3A%2F%2Fjournals.openedition.org%2Fcorela%2F4540%22%2C%22author%22%3A%5B%7B%22family%22%3A%22%C2%B5%22%2C%22given%22%3A%22Groupe%22%7D%2C%7B%22family%22%3A%22%C3%89deline%22%2C%22given%22%3A%22Francis%22%7D%2C%7B%22family%22%3A%22Klinkenberg%22%2C%22given%22%3A%22Jean-Marie%22%7D%5D%2C%22accessed%22%3A%7B%22date-parts%22%3A%5B%5B%222019%22%2C11%2C5%5D%5D%7D%2C%22issued%22%3A%7B%22date-parts%22%3A%5B%5B%222016%22%2C6%2C13%5D%5D%7D%7D%7D%5D&quot; data-schema-version=&quot;6&quot;&gt;
&lt;h1&gt;Annotations&lt;br&gt;(02/04/2022 &amp;agrave; 08:47:31)&lt;/h1&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%228EVSYZ9D%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%221%22%2C%22position%22%3A%7B%22pageIndex%22%3A1%2C%22rects%22%3A%5B%5B223.843%2C144.498%2C453.211%2C155.743%5D%2C%5B85.039%2C130.416%2C453.202%2C141.661%5D%2C%5B85.039%2C116.338%2C453.182%2C127.583%5D%2C%5B85.039%2C102.256%2C251.084%2C113.501%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%221%22%7D%7D&quot;&gt;&amp;laquo; La s&amp;eacute;miose, loin d&amp;rsquo;&amp;ecirc;tre un ph&amp;eacute;nom&amp;egrave;ne sans lien avec le corps, tire son origine de celui-ci. Ce premier aspect de la corpor&amp;eacute;it&amp;eacute; du sens peut &amp;ecirc;tre qualifi&amp;eacute; de cognitif : le signe &amp;eacute;merge de l&amp;rsquo;exp&amp;eacute;rience, et ne saurait &amp;ecirc;tre &amp;eacute;tudi&amp;eacute; qu&amp;rsquo;&amp;agrave; travers les interactions qu&amp;rsquo;il a avec son contexte &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%221%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 1&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; width=&quot;489&quot; height=&quot;310&quot; data-attachment-key=&quot;9XWUW59H&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22MECAQKU4%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%222%22%2C%22position%22%3A%7B%22pageIndex%22%3A2%2C%22rects%22%3A%5B%5B58.488%2C481.638%2C352.051%2C667.786%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%222%22%7D%7D&quot;&gt;&lt;br&gt;&lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%222%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 2&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22SU4XCGF9%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%223%22%2C%22position%22%3A%7B%22pageIndex%22%3A3%2C%22rects%22%3A%5B%5B379.194%2C263.607%2C453.195%2C274.853%5D%2C%5B85.039%2C249.525%2C193.769%2C260.771%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%223%22%7D%7D&quot;&gt;&amp;laquo; la mise en service d&amp;rsquo;une grille interpr&amp;eacute;tative &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%223%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 3&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22MFKRUK4A%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%225%22%2C%22position%22%3A%7B%22pageIndex%22%3A5%2C%22rects%22%3A%5B%5B85.039%2C652.716%2C453.092%2C663.962%5D%2C%5B85.039%2C637.864%2C453.224%2C649.11%5D%2C%5B85.039%2C623.783%2C287.142%2C635.028%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%225%22%7D%7D&quot;&gt;&amp;laquo; Pour Peirce et ses disciples (Marty, &amp;sect; 60), la semiosis ou s&amp;eacute;miose est &amp;laquo; un processus qui se d&amp;eacute;roule dans l&amp;rsquo;esprit de l&amp;rsquo;interpr&amp;egrave;te : il d&amp;eacute;bute avec la perception du signe et se termine avec la pr&amp;eacute;sence &amp;agrave; son esprit de l&amp;rsquo;objet du signe &amp;raquo;. &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%225%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 5&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%228TIX6CKH%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%225%22%2C%22position%22%3A%7B%22pageIndex%22%3A5%2C%22rects%22%3A%5B%5B201.538%2C303.123%2C453.231%2C314.369%5D%2C%5B85.039%2C289.041%2C453.236%2C300.287%5D%2C%5B85.039%2C274.959%2C453.188%2C286.205%5D%2C%5B85.039%2C260.877%2C453.321%2C272.123%5D%2C%5B85.039%2C246.795%2C209.49%2C258.041%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%225%22%7D%7D&quot;&gt;&amp;laquo; Umberto Eco, lui, tire davantage Peirce du c&amp;ocirc;t&amp;eacute; de l&amp;rsquo;action en le r&amp;eacute;sumant de cette mani&amp;egrave;re : &amp;laquo; Les interpr&amp;eacute;tants logiques finaux sont les habitudes, les dispositions &amp;agrave; l&amp;rsquo;action, et donc &amp;agrave; l&amp;rsquo;intervention sur les choses, vers quoi tend toute la s&amp;eacute;miose &amp;raquo; ; et de poursuivre : &amp;laquo; L&amp;rsquo;interpr&amp;eacute;tant d&amp;rsquo;un signe peut &amp;ecirc;tre une action ou un comportement &amp;raquo; (1988 : 204). &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%225%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 5&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22LT97USHB%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%227%22%2C%22position%22%3A%7B%22pageIndex%22%3A7%2C%22rects%22%3A%5B%5B164.227%2C328.263%2C453.274%2C339.508%5D%2C%5B85.039%2C314.181%2C277.405%2C325.426%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%227%22%7D%7D&quot;&gt;&amp;laquo; il ne suffit donc pas de percevoir le monde pour en tirer une information, mais il faut le percevoir deux fois &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%227%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 7&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22URK5PEIB%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%227%22%2C%22position%22%3A%7B%22pageIndex%22%3A7%2C%22rects%22%3A%5B%5B374.496%2C300.099%2C453.289%2C311.344%5D%2C%5B85.039%2C286.017%2C453.209%2C297.262%5D%2C%5B85.039%2C271.935%2C453.29%2C283.181%5D%2C%5B85.039%2C257.857%2C453.152%2C269.103%5D%2C%5B85.039%2C243.775%2C453.214%2C255.021%5D%2C%5B85.039%2C229.693%2C436.101%2C240.939%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%227%22%7D%7D&quot;&gt;&amp;laquo; Cet individu est en effet plong&amp;eacute; dans de nombreux flux entrecrois&amp;eacute;s : flux de mati&amp;egrave;re (le vent, les courants d&amp;rsquo;eau, la nourriture...), flux d&amp;rsquo;&amp;eacute;nergie (la chaleur solaire, la pesanteur...), flux de radiations diverses (la lumi&amp;egrave;re, le son...). Tous ces flux sont orient&amp;eacute;s, et caract&amp;eacute;ris&amp;eacute;s par une variation le long d&amp;rsquo;un axe, c&amp;rsquo;est-&amp;agrave;-dire un gradient. Vivre revient &amp;agrave; se situer parmi ces gradients. Et le dip&amp;ocirc;le est l&amp;rsquo;outil utilis&amp;eacute; par les &amp;ecirc;tres vivants pour atteindre ce r&amp;eacute;sultat &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%227%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 7&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;img alt=&quot;&quot; width=&quot;606&quot; height=&quot;494&quot; data-attachment-key=&quot;5XNSUNBG&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22L4Y7HNQI%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%228%22%2C%22position%22%3A%7B%22pageIndex%22%3A8%2C%22rects%22%3A%5B%5B74.234%2C331.482%2C438.095%2C627.857%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%228%22%7D%7D&quot;&gt;&lt;br&gt;&lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%228%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 8&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%229QNJDJ3X%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%229%22%2C%22position%22%3A%7B%22pageIndex%22%3A9%2C%22rects%22%3A%5B%5B85.039%2C633.243%2C453.197%2C644.489%5D%2C%5B85.039%2C618.391%2C453.168%2C629.637%5D%2C%5B85.039%2C604.31%2C308.41%2C615.806%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%229%22%7D%7D&quot;&gt;&amp;laquo; Le r&amp;eacute;sultat final est une modification des propri&amp;eacute;t&amp;eacute;s &amp;eacute;lastiques des myofilaments, qui se raidissent en se contractant. Plus pr&amp;eacute;cis&amp;eacute;ment &amp;agrave; ce niveau deux r&amp;eacute;ponses sont possibles, &amp;eacute;galement importantes : la contraction et l&amp;rsquo;inhibition8. &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%229%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 9&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22Y7X7WQT7%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%2210%22%2C%22position%22%3A%7B%22pageIndex%22%3A10%2C%22rects%22%3A%5B%5B85.039%2C708.673%2C453.206%2C719.919%5D%2C%5B85.039%2C693.822%2C149.134%2C705.067%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%2210%22%7D%7D&quot;&gt;&amp;laquo; Les syst&amp;egrave;mes de signes y jouent &amp;eacute;galement un r&amp;ocirc;le. Plusieurs de leurs propri&amp;eacute;t&amp;eacute;s sont pertinentes ici : &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%2210%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 10&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22WRATGNX6%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%2210%22%2C%22position%22%3A%7B%22pageIndex%22%3A10%2C%22rects%22%3A%5B%5B85.039%2C676.907%2C452.384%2C689.935%5D%2C%5B85.039%2C662.056%2C453.158%2C673.301%5D%2C%5B85.039%2C647.974%2C260.742%2C659.219%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%2210%22%7D%7D&quot;&gt;&amp;laquo; ▪ stabilisant la cat&amp;eacute;gorie (notamment en renfor&amp;ccedil;ant sa stabilisation interindividuelle), ils facilitent la r&amp;eacute;p&amp;eacute;tition des actions sur lesquelles elle peut d&amp;eacute;boucher : en d&amp;rsquo;autres termes, ils renforcent la routinisation en question ; &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%2210%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 10&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span class=&quot;highlight&quot; data-annotation=&quot;%7B%22attachmentURI%22%3A%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F4NB3V5DX%22%2C%22annotationKey%22%3A%22PZQ8V9VU%22%2C%22color%22%3A%22%23ffd400%22%2C%22pageLabel%22%3A%2210%22%2C%22position%22%3A%7B%22pageIndex%22%3A10%2C%22rects%22%3A%5B%5B85.039%2C633.892%2C452.408%2C646.919%5D%2C%5B85.038%2C619.81%2C453.181%2C631.056%5D%2C%5B85.038%2C605.728%2C453.222%2C616.974%5D%2C%5B85.038%2C591.646%2C453.229%2C602.892%5D%2C%5B85.038%2C577.564%2C267.36%2C588.81%5D%5D%7D%2C%22citationItem%22%3A%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%2210%22%7D%7D&quot;&gt;&amp;laquo; ▪ constituant une s&amp;eacute;miose indirecte, ils permettent d&amp;rsquo;exp&amp;eacute;rimenter sur des substituts au lieu d&amp;rsquo;exp&amp;eacute;rimenter sur des choses. C&amp;rsquo;est particuli&amp;egrave;rement le cas des r&amp;eacute;cits, qui int&amp;egrave;grent d&amp;rsquo;une part une dimension syntaxique, d&amp;rsquo;autre part une dimension sociale : ils fournissent des cadres permettant de donner sens aux actions des sujets et de leurs partenaires (Gallagher 2006 ; Gallagher et Hutto 2008). &amp;raquo;&lt;/span&gt; &lt;span class=&quot;citation&quot; data-citation=&quot;%7B%22citationItems%22%3A%5B%7B%22uris%22%3A%5B%22http%3A%2F%2Fzotero.org%2Fusers%2F13594%2Fitems%2F34C89CEH%22%5D%2C%22locator%22%3A%2210%22%7D%5D%2C%22properties%22%3A%7B%7D%7D&quot;&gt;(&lt;span class=&quot;citation-item&quot;&gt;&amp;micro; et al., 2016, p. 10&lt;/span&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;</rdf:value>
