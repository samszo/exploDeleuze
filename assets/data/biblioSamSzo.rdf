    </bib:Thesis>
    <bib:Memo rdf:about="#item_1836">
        <rdf:value>&lt;p&gt;&quot;La reconnaissance automatique de la parole est en effet un défi qui passionne la communauté scientifique depuis de nombreuses années. Mais le mythe d'une machine qui, à défaut de les comprendre, retranscrirait parfaitement les propos d'un être humain s'est peu à peu fissuré.&quot; p. 14&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>automatique</dc:subject>
        <dc:subject>mythe</dc:subject>
        <dc:subject>transcription</dc:subject>
    </bib:Memo>
