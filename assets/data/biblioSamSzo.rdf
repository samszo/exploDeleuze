        <dc:title>Indexation de documents pédagogiques : fusionner les approches du Web Sémantique et du Web Participatif</dc:title>
        <dc:date>2009</dc:date>
        <z:libraryCatalog>Google Scholar</z:libraryCatalog>
    </bib:Thesis>
    <bib:Memo rdf:about="#item_2914">
        <rdf:value>&lt;p&gt;&quot;commencer à participer avec des efforts minimaux (Sous-objectif 1). Puis si l'utilisateur le désire et s'il en a le temps, il peut s'impliquer davantage en prenant progressivement en compte l'activité des autres utilisateurs (jusqu'à collaborer, Sous-objectif 2) ou en structurant davantage les métadonnées des documents (jusqu'à presque les formaliser, Sous-objectif 3).&quot; p. 197&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>point de vu</dc:subject>
        <dc:subject>multiple</dc:subject>
        <dc:subject>indexation</dc:subject>
        <dc:subject>progression</dc:subject>
    </bib:Memo>
    <rdf:Description rdf:about="#item_476">
        <z:itemType>document</z:itemType>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Mariani</foaf:surname>
                        <foaf:givenName>Joseph</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Besnier</foaf:surname>
                        <foaf:givenName>Jean-Michel</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
