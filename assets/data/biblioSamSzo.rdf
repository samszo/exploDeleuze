        <dc:subject>gouvernement</dc:subject>
        <dc:subject>thésaurus</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2741">
        <rdf:value>&lt;p&gt;&quot;Même après modifications, on ne saurait donc encore qualifier  d'intuitive l'utilisation des macrothésauri gouvernementaux&quot; p. 221&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2740">
        <rdf:value>&lt;p&gt;&quot;On est loin de l'intéractivité offerte par le Social Science   Information Gateway [&lt;a href=&quot;http://www.sosig.ac.uk/&quot;&gt;www.sosig.ac.uk&lt;/a&gt; ] ou le search   Eric [searcheric.org] par exemple, qui présente des modèles intéressants   d'intégration du langage documentaire à l'interface de recherche.&quot; p.   221&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:BookSection rdf:about="#item_345">
        <z:itemType>bookSection</z:itemType>
