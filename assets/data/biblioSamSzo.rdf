        <link:link rdf:resource="#item_1957"/>
        <dc:title>L'école du silence: le sentiment des images au XVIIe siècle</dc:title>
        <dc:date>1998</dc:date>
        <z:shortTitle>L'école du silence</z:shortTitle>
        <z:libraryCatalog>Google Books</z:libraryCatalog>
        <dc:identifier>ISBN 978-2-08-081633-7</dc:identifier>
        <z:numPages>678</z:numPages>
    </bib:Book>
    <bib:Memo rdf:about="#item_2790">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;Académie, Arcadie, Parnasse : trois lieux allégoriques du loisir lettré&quot; p. 19&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>lieu</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2807">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;Le mouvement premier de l'allégorie, il faut le dire, est le rêve qui fait voir la réalité. Un tel mouvement suppose un état de voyance analogue à celui que décrit Beaudelaire dans &lt;em&gt;Le Cygne&lt;/em&gt; , et qui lui fait dire : &quot;Tout pour moi devient allégorie&quot;. Le Moyen Age et la Renaissance ont fait de cet état visionnaire, et de l'invention de l'allégorie qu'il rend possible, l'état poétique par excellence.&quot; p. 87&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>poésie</dc:subject>
        <dc:subject>rêve</dc:subject>
    </bib:Memo>
    <z:Attachment rdf:about="#item_1957">
        <z:itemType>attachment</z:itemType>
