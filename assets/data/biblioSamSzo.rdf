        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Hock-koon</foaf:surname>
                        <foaf:givenName>Anthony</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Oussalah</foaf:surname>
                        <foaf:givenName>Mourad</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
