    <bib:Book rdf:about="urn:isbn:978-2-271-06133-1">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Paris</vcard:locality>
