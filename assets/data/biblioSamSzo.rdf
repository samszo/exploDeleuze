        <dc:title>Soufisme et art visuel: Iconographie du sacré</dc:title>
        <dc:date>2000-05-03</dc:date>
        <z:shortTitle>Soufisme et art visuel</z:shortTitle>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-7384-6348-7</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2602">
        <rdf:value>&lt;p&gt;«&amp;nbsp;Curieusement, Ibn'Arabi appelle ce schéma «&amp;nbsp;l'image du monde tout entier avec son classement par degrés spirituels et physiques, en haut ou en bas&amp;nbsp;». Il s'agit d'un plan d'une simplicité signifiante qui illustre une des idées majeures de l'art islamiques : reproduire le cercle en tant qu'expression du cosmos circulaire&amp;nbsp;» p. 120&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>espace</dc:subject>
        <dc:subject>divin</dc:subject>
        <dc:subject>image</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2598">
        <rdf:value>&lt;p&gt;«&amp;nbsp;Pour la pensée islamique prédominante, il est impossible de concevoir la dimension de l'espace divin ; il est homogène malgré (ou grâce à à l'ubiquité de Dieu. Mais il n'est pas tout à fait homogène du point de vue ésotérique.&amp;nbsp;» p. 25&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>espace</dc:subject>
        <dc:subject>divin</dc:subject>
    </bib:Memo>
