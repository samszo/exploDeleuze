        <dc:title>L'intelligence collective : une notion en chantier</dc:title>
        <dc:date>2006</dc:date>
        <z:language>fr</z:language>
        <z:libraryCatalog>Google Books</z:libraryCatalog>
    </rdf:Description>
    <bib:Memo rdf:about="#item_2915">
        <rdf:value>&lt;p&gt;&quot;En effet cette dernière [l'intelligence collective], quoiqu'en aient dit ses concepteurs, est souvent considérée comme suspecte de constituer la connaissance en patrimoine plutôt que de favoriser l'innovation et la créativité.&quot; p. 34&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>critique</dc:subject>
        <dc:subject>intelligence</dc:subject>
        <dc:subject>collective</dc:subject>
    </bib:Memo>
