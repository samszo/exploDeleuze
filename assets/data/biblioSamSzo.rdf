                    <foaf:Person>
                        <foaf:surname>Chogyam</foaf:surname>
                        <foaf:givenName>Trungpa</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2822"/>
        <link:link rdf:resource="#item_1971"/>
        <dc:title>Mandala. un Chaos Ordonne</dc:title>
        <dc:date>1994</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-7578-2324-8</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_2822">
        <rdf:value>&lt;p&gt;&quot;Du point de vue de l'état éveillé, le mandala fondamental n'exige pas la transmission de messages linéaires pour voir les choses telles qu'elles sont, et c'est pour cette raison qu'on utilise le mot &quot;transmutation&quot; dans la tradition trantique. La transmutation se caractérise par le fait que le plomb est entièrement transformé en or : il devient l'or pour, sans aucun résidu de plomb.&quot; p. 81&lt;/p&gt;</rdf:value>
        <dc:subject>alchimie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>mandala</dc:subject>
    </bib:Memo>
