    <bib:Memo rdf:about="#item_2737">
        <rdf:value>&lt;!-- 		@page { margin: 2cm } 		P { margin-bottom: 0.21cm } --&gt;
&lt;p style=&quot;margin-bottom: 0cm;&quot;&gt;«&amp;nbsp;La question, &lt;em&gt;une machine peut-elle penser ?&lt;/em&gt; est donc dénué de sens, et c'est pourquoi il faut lui substituer le jeu de l'imitation, renoncer à expliquer ce qu'est l'esprit et prouver en quelque sorte le mouvement en marchant.&amp;nbsp;» p.59&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
