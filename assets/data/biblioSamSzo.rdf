               <rdf:value>http://books.google.fr/books?id=9pbpAAAAMAAJ</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2011-03-06 17:09:10</dcterms:dateSubmitted>
        <z:linkMode>3</z:linkMode>
        <link:type>text/html</link:type>
    </z:Attachment>
    <bib:Book rdf:about="#item_499">
        <z:itemType>book</z:itemType>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Winckelmann</foaf:surname>
                        <foaf:givenName>Johann Joachim</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2791"/>
        <dcterms:isReferencedBy rdf:resource="#item_2808"/>
        <dcterms:isReferencedBy rdf:resource="#item_2811"/>
        <dcterms:isReferencedBy rdf:resource="#item_2810"/>
        <dcterms:isReferencedBy rdf:resource="#item_2797"/>
        <dcterms:isReferencedBy rdf:resource="#item_2792"/>
        <dcterms:isReferencedBy rdf:resource="#item_2794"/>
        <dcterms:isReferencedBy rdf:resource="#item_2796"/>
        <dcterms:isReferencedBy rdf:resource="#item_2795"/>
        <dcterms:isReferencedBy rdf:resource="#item_2809"/>
        <dcterms:isReferencedBy rdf:resource="#item_2793"/>
        <link:link rdf:resource="#item_1958"/>
        <dc:title>De l'allégorie, ou Traités sur cette matière; par Winckelmann, Addison, Sulzer, etc. [tr. and ed. by H. Jansen].</dc:title>
        <dc:date>1799</dc:date>
        <z:libraryCatalog>Google Books</z:libraryCatalog>
        <z:numPages>442</z:numPages>
    </bib:Book>
    <bib:Memo rdf:about="#item_2791">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;... l'allégorie est la représentation de ce qui est universel ou abstrait, par des objets sensibles et individuels.&quot; p. 238&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>universel</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2808">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;... l'allégorie ne se borne point à des idées simples ; elles en embrasse de composées ; dans lesquelles plusieurs sont liées de manière à former un tout ; elle peut représenter des vérités générales et devient par-là un véritable langage. [...] Dans le langage (ordinaire), ces signes sont arbitraire ; dans l'allégorie, ils sont naturels [...] c'est une langue universelle, à la portée de quiconque sait penser&quot;. p. 238&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>universel</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2811">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;... les qualités essentielles de l'allégorie sont la ressemblance parfaite de l'image avec l'objet ; de manière que la première rappelle promptement l'autre, et la force esthétique de l'image [...] il ne faut pas qu'elle soit poussée trop loin, il ne faut pas y mêler l'expression propre de la chose même : ces deux défauts la rendroient absurde&quot; p. 215&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>absurde</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2810">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;L'allégorie est donc l'espèce d'images qui a le plus d'énergie, et les comparaisons qui en approchent le plus sont toujours les plus vives.&quot; p. 218&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>énergie</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2797">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;L'allégorie est un signe naturel, ou une image que l'on met à la place de la chose même que l'on veut exprimer ou représenter&quot; p. 213&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2792">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;L'allégorie sert à un but plus grand encore, celui de donner aux choses plus d'énergie, plus de clarté, plus de vie&quot; p. 223&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>énergie</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2794">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;L'emploi de l'allégorie devient plus important lorsqu'on n'a pas seulement pour but de s'exprimer ingénieusement, mais qu'on cherche encore, à l'aide de l'allégorie, à cacher ce qu'on veut dire, jusqu'à ce que les auditeurs, ou remplis de préjugés, ou éblouis par des illusions, aient eux-mêmes prononcés le jugement qu'on veut leur faire porter.&quot; p. 220&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2796">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;Le proverbe si connu, petite pluie abat grand vent, nous apprend cette vérité morale, que la patience et la douceur triomphent à la longue de la violence.&quot; p. 213&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>proverbe</dc:subject>
        <dc:subject>climat</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2795">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;On se sert d'allégories dans différentes occasions. Souvent c'est par nécessité, lorsqu'il n'est pas possible de représenter les objets mêmes ; c'est ainsi que la peinture exprime les idées universelles ou abstraites ; dont l'objet ne tombe sous le sens. D'autres fois, c'est par circonspection, lorsqu'on craint de présenter la chose même que l'on a dans l'esprit, et qu'on aime mieux la laisser deviner.&quot; p. 214&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>définition</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2809">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;&amp;nbsp;Pour trouver des allégories parfaites, qui, au mérite de rendre les chose sensibles, réunissent les effets que le beau produit sur l'âme, observez attentivement la nature, ne vous arrêtez pas seulement à la surface des objets, mais sachez pénétrer dans le monde corporel invisible.&quot; p. 226&lt;/p&gt;</rdf:value>
        <dc:subject>alchimie</dc:subject>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2793">
        <rdf:value>&lt;p lang=&quot;fr-FR&quot;&gt;&quot;Souvent l'allégorie doit seulement rendre une idée plus claire, plus sensible, plus ineffaçable&quot; p. 220&lt;/p&gt;</rdf:value>
        <dc:subject>allégorie</dc:subject>
        <dc:subject>citation</dc:subject>
    </bib:Memo>
    <z:Attachment rdf:about="#item_1958">
        <z:itemType>attachment</z:itemType>
