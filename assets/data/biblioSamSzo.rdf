    <bib:Book rdf:about="urn:isbn:2-7073-0307-0%20978-2-7073-0307-3">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Paris</vcard:locality>
                    </vcard:Address>
                </vcard:adr>
                <foaf:name>Éditions de minuit</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Deleuze</foaf:surname>
                        <foaf:givenName>Gilles</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Guattari</foaf:surname>
                        <foaf:givenName>Félix</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_3242"/>
        <dcterms:isReferencedBy rdf:resource="#item_2876"/>
        <dcterms:isReferencedBy rdf:resource="#item_2867"/>
        <dcterms:isReferencedBy rdf:resource="#item_2875"/>
        <dc:title>Mille plateaux</dc:title>
        <dc:date>1980</dc:date>
        <dc:identifier>ISBN 2-7073-0307-0 978-2-7073-0307-3</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_3242">
        <rdf:value>&lt;p&gt;&quot;Ce qui compte, c'est que l'arbre-racine et le rhizome-canal ne s'opposent pas comme deux modèles : l'un agit comme modèle et comme calque transcendants, même s'il engendre ses propres fuites ; l'autre agit comme processus immanent qui renverse le modèle et ébauche une carte, même s'il constitue ses propres hiérarchies, même s'il suscite un canal despotique.&quot; p. 31&lt;/p&gt;</rdf:value>
        <dc:subject>arbre</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>rhizome</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2876">
        <rdf:value>&lt;p&gt;&lt;span style=&quot;font-family:arial;font-size:small;&quot;&gt;&quot;le moine-maçon Garin de Troyes, invoque une logique opératoire du mouvement qui permet à l' &lt;span style=&quot;font-family:sans-serif;font-size:13px;line-height:19px;&quot;&gt;‹ &lt;/span&gt;initié &lt;span style=&quot;font-family:sans-serif;font-size:13px;line-height:19px;&quot;&gt;›&lt;/span&gt; de tracer, puis de couper les volumes en pénétration dans l'espace, et de faire que &lt;span style=&quot;font-family:sans-serif;line-height:19px;&quot;&gt;‹ le trait pousse le chiffre &lt;/span&gt;&lt;span style=&quot;font-family:sans-serif;line-height:19px;&quot;&gt;›. on ne représente pas, on engendre et on parcourt. C'est moins l'absence d'équations qui caractérise cette science que le rôle différent qu'elles ont éventuellement : au lieu d'être de bonnes formes absolument qui organisent la matière, elles sont &lt;/span&gt;&lt;span style=&quot;font-family:sans-serif;font-size:13px;line-height:19px;&quot;&gt;‹ &lt;/span&gt;générées &lt;span style=&quot;font-family:sans-serif;font-size:13px;line-height:19px;&quot;&gt;›, comme &lt;/span&gt;&lt;span style=&quot;font-family:sans-serif;font-size:13px;line-height:19px;&quot;&gt;‹ &lt;/span&gt;poussées &lt;span style=&quot;font-family:sans-serif;font-size:13px;line-height:19px;&quot;&gt;› par le matériau, dans un calcul qualitatif d'optimum&quot; p. 451&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;</rdf:value>
        <dc:subject>jardin</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>pédagogie</dc:subject>
        <dc:subject>matière</dc:subject>
        <dc:subject>équation</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2867">
        <rdf:value>&lt;p&gt;&quot;Principes de connexion et d'hétérogénéité : n'importe quel point d'un rhizome peut-être connecté avec n'importe quel autre, et doit l'être. C'est très différent de l'arbre ou de la racine qui fixe un point, un ordre.&quot; p. 13&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>principes</dc:subject>
        <dc:subject>rhizome</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2875">
        <rdf:value>&lt;p&gt;&quot;si le territoire en extension sépare les forces intérieures de la terre et les forces extérieures du chaos, il n'en est pas de même en &quot; intension &quot;, en profondeur, où les deux types de forces s'étreignent et s'épousent en un combat qui n'a que la terre comme crible et comme enjeu.&quot; p. 395&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>IN&lt;-&gt;OUT</dc:subject>
        <dc:subject>crible</dc:subject>
    </bib:Memo>
    <bib:Book rdf:about="#item_536">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Paris</vcard:locality>
                    </vcard:Address>
                </vcard:adr>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Baltz</foaf:surname>
                        <foaf:givenName>Claude</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_2481"/>
        <dcterms:isReferencedBy rdf:resource="#item_2007"/>
        <dcterms:isReferencedBy rdf:resource="#item_2480"/>
        <dcterms:isReferencedBy rdf:resource="#item_2479"/>
        <dcterms:isReferencedBy rdf:resource="#item_2958"/>
        <dc:title>Shannon, critiques, dépliages, reconstruction</dc:title>
        <dc:date>2010</dc:date>
        <prism:edition>Europia Production</prism:edition>
    </bib:Book>
    <bib:Memo rdf:about="#item_2481">
        <rdf:value>&lt;p&gt;&quot;Cette linéarisation peut se comprendre comme un effet de zoom moyen mais on ne peut pas s‟empêcher de penser que, selon l‟échelle choisie, elle écrase conceptuellement l‟accès à des phénomènes buissonnants de communication locale. [...] ce qui n‟est alors pas sans rappeler un peu l‟image des rapports entre texte classique et hypertexte…&quot; p. 31&lt;/p&gt;</rdf:value>
        <dc:subject>jardin</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>linéaire</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2007">
        <rdf:value>&lt;p&gt;&quot;Elle [la communication] sera entendue ici au sens : un processus de communication dans lequel circule de l’information…&quot; p. 33&lt;/p&gt;</rdf:value>
        <dc:subject>communication</dc:subject>
        <dc:subject>flux</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2480">
        <rdf:value>&lt;p&gt;&quot;le fil conducteur de ce texte sera de comprendre systématiquement la mesure de l‟information apportée par un événement comme un nombre de questions nécessaire pour identifier cet événement&quot; p. 4&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>question</dc:subject>
        <dc:subject>évènement</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2479">
        <rdf:value>&lt;p&gt;&quot;le schéma « simplifié » - le plus courant - comporte explicitement un canal à propos duquel il faut remarquer que sa première caractéristique, matériellement confortée d‟ailleurs par le jeu de communication ci-dessus, est qu‟il possède des parois. [...] traitée par ailleurs à travers le concept de « tubulation » [BAL, 1976] ).&quot; p. 45&lt;/p&gt;</rdf:value>
        <dc:subject>communication</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>tube</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2958">
        <rdf:value>&lt;p&gt;&quot;pas d’information sans communication et vice-versa. Nous devons donc à la fois utiliser les deux termes sans plus d‟états d‟âme épistémologiques et être prêts à accepter, si nécessaire, les conséquences de leur enchevêtrement fractal&quot; p. 33&lt;/p&gt;</rdf:value>
        <dc:subject>communication</dc:subject>
        <dc:subject>information</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>fractal</dc:subject>
    </bib:Memo>
