                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Descola</foaf:surname>
                        <foaf:givenName>Philippe</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_3306"/>
        <dcterms:isReferencedBy rdf:resource="#item_3308"/>
        <dcterms:isReferencedBy rdf:resource="#item_3305"/>
        <dcterms:isReferencedBy rdf:resource="#item_3304"/>
        <dcterms:isReferencedBy rdf:resource="#item_3988"/>
