        <link:link rdf:resource="#item_2042"/>
        <dc:relation rdf:resource="#item_2519"/>
        <dc:title>Sur le tissage des connaissances</dc:title>
        <dc:date>2006-05-13</dc:date>
        <z:libraryCatalog>Amazon.com</z:libraryCatalog>
        <dc:identifier>ISBN 2-7462-1438-5</dc:identifier>
    </bib:Book>
    <bib:Memo rdf:about="#item_1626">
        <rdf:value>&lt;p&gt;&quot;Elle [MCR] &amp;eacute;labore un syst&amp;egrave;me coh&amp;eacute;rent et consensuel d'algorithmes de conceptualisation : des algorithmes de g&amp;eacute;n&amp;eacute;ration et d&amp;eacute;veloppement de sens; &amp;agrave; caract&amp;egrave;re effectif et prot&amp;eacute;g&amp;eacute;s par construction de toute insertion de faux probl&amp;egrave;mes ou de paradoxes.&quot; p. 314&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>algorithme</dc:subject>
        <dc:subject>cohérence</dc:subject>
        <dc:subject>paradoxe</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1625">
        <rdf:value>&lt;p&gt;&quot;L'esprit &amp;eacute;labore des connaissances en travaillant entre [un absolu connu tel qu'il est] et [un absolu &amp;agrave; jamais ext&amp;eacute;rieur &amp;agrave; la connaissance], mais &amp;agrave; partir duquel on &amp;eacute;labore des descriptions communicables et susceptibles de consensus intersubjectifs.&quot; p. 136&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>connaissance</dc:subject>
        <dc:subject>absolu</dc:subject>
        <dc:subject>intuition</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_1624">
        <rdf:value>&lt;p&gt;&quot;On voit que le caract&amp;egrave;re m&amp;eacute;thodologique s'impose ici comme une solution qui peuple un tranchant de l'espace des conceptualisations, une ar&amp;ecirc;te entre l'impossibilit&amp;eacute; de construire et l'impossibilit&amp;eacute; d'&amp;eacute;viter un r&amp;eacute;alisme na&amp;iuml;f, sur laquelle on doit imp&amp;eacute;rativement se maintenir sans glisser ni d'un cot&amp;eacute; ni de l'autre.&quot; p. 64&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>IEML</dc:subject>
        <dc:subject>réalisme</dc:subject>
        <dc:subject>solution</dc:subject>
        <dc:subject>tranchant</dc:subject>
    </bib:Memo>
