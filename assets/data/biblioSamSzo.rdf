    <bib:Thesis rdf:about="http://tel.archives-ouvertes.fr/tel-00806418">
        <z:itemType>thesis</z:itemType>
        <dc:publisher>
            <foaf:Organization>
               <foaf:name>Université du Havre</foaf:name>
