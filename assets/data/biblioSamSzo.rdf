                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Juanals</foaf:surname>
                        <foaf:givenName>Brigitte</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Noyer</foaf:surname>
                        <foaf:givenName>Jean-Max</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
