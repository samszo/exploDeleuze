    <bib:Book rdf:about="urn:isbn:978-2-7465-0339-7%202-7465-0339-5">
        <z:itemType>book</z:itemType>
        <dc:publisher>
            <foaf:Organization>
                <vcard:adr>
                    <vcard:Address>
                       <vcard:locality>Paris</vcard:locality>
                    </vcard:Address>
                </vcard:adr>
                <foaf:name>le Pommier</foaf:name>
            </foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Harrison</foaf:surname>
                        <foaf:givenName>Robert Pogue.</foaf:givenName>
                    </foaf:Person>
                </rdf:li>
            </rdf:Seq>
        </bib:authors>
        <dcterms:isReferencedBy rdf:resource="#item_3123"/>
        <dcterms:isReferencedBy rdf:resource="#item_3125"/>
        <dcterms:isReferencedBy rdf:resource="#item_3132"/>
