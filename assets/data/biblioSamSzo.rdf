    <bib:Memo rdf:about="#item_2775">
        <rdf:value>&lt;p&gt;&quot;En 1895, sa classification [Dewey] est découverte par Paul Otlet au cours d'un voyage à Londres. [...] Mais cette première expérience a fait découvrir certaines difficultés d'application. On s'en ouvre à Dewey qui accepte l'idée de coopération et d'adaptation de sa DC. Dès lors, cette classification va devenir la &quot;Classification Décimale Universelle&quot; p. 1&lt;/p&gt;</rdf:value>
        <dc:subject>citation</dc:subject>
        <dc:subject>classification</dc:subject>
        <dc:subject>anecdote</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2781">
        <rdf:value>&lt;p&gt;&quot;Gabriel Naudé consacre le chapitre VII de son célèbre traité de bibliothéconomie à l'ordre qu'il faut donner au livre&quot; p. 5&lt;/p&gt;</rdf:value>
        <dc:subject>histoire</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>classification</dc:subject>
    </bib:Memo>
    <bib:Memo rdf:about="#item_2774">
        <rdf:value>&lt;p&gt;&quot;trois grandes classifications philosophiques: celle de Lulle de Bacon et celle de Diderot et d'Alemenbert&quot; p. 3&lt;/p&gt;</rdf:value>
        <dc:subject>histoire</dc:subject>
        <dc:subject>citation</dc:subject>
        <dc:subject>classification</dc:subject>
    </bib:Memo>
