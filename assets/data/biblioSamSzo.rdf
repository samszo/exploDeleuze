            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2020-11-02 05:52:49</dcterms:dateSubmitted>
        <dc:description>Publisher: Institut national de recherche pour l’agriculture, l’alimentation et l’environnement (INRAE)</dc:description>
        <bib:pages>16-28</bib:pages>
