# Emplacement des artefacts générés (matrice d'adjacence, état de rétention,
# store synthétique). Par défaut : <cwd>/data. À définir en chemin absolu si
# vous lancez `mastra dev`, qui exécute le code depuis un répertoire
# bac-à-sable interne où process.cwd() ne pointe pas vers la racine du projet.
# DATA_DIR=/Users/samszo/Sites/exploDeleuze/mastra/data

# --- Socle de connaissances (Omeka S) ---
# synthetic : corpus deleuzien de démonstration, persisté dans data/ (aucun service externe requis)
# live      : instance Omeka S réelle, via son API REST
OMEKA_MODE=synthetic
OMEKA_BASE_URL=https://votre-instance-omeka.example.org/api
OMEKA_KEY_IDENTITY=
OMEKA_KEY_CREDENTIAL=
OMEKA_EMBEDDING_PROPERTY_ID=99
OMEKA_EMBEDDING_PROPERTY_TERM=pretopo:embedding
# IDs internes des propriétés Dublin Core Terms utilisées pour créer les notes
# du Chroniqueur Cognitif (étape 10). Vérifier ces valeurs dans votre instance
# (Contenu > Vocabulaires) : elles varient selon les installations Omeka S.
OMEKA_TITLE_PROPERTY_ID=1
OMEKA_DESCRIPTION_PROPERTY_ID=4
OMEKA_IS_VERSION_OF_PROPERTY_ID=45
# Secret partagé attendu dans l'en-tête x-webhook-secret des requêtes envoyées
# par Omeka S vers /webhooks/omeka/item-updated. Laisser vide uniquement en
# développement local ; à définir avant toute exposition publique du serveur.
OMEKA_WEBHOOK_SECRET=

# --- Embeddings (affinité sémantique S_AB) ---
# synthetic : hachage bag-of-words déterministe, aucun service externe requis
# tei       : serveur Text Embeddings Inference local chargé avec BAAI/bge-m3
#   docker run -p 8080:80 -v $(pwd)/data/tei-model:/data \
#     ghcr.io/huggingface/text-embeddings-inference:cpu-1.5 --model-id BAAI/bge-m3
#   (remplacer le tag cpu-1.5 par la variante GPU si disponible)
EMBEDDINGS_PROVIDER=synthetic
TEI_BASE_URL=http://localhost:8080

# --- Dynamique rhizomatique ---
# I_AB(t) = alpha * S_AB + beta * R_AB(t) + gamma * F_AB
# lambda_AB = lambda_base / (1 + kappa * S_AB)
RHIZOME_ALPHA=0.4
RHIZOME_BETA=0.5
RHIZOME_GAMMA=0.1
RHIZOME_LAMBDA_BASE=0.15
RHIZOME_KAPPA=4
RHIZOME_TRAVERSAL_INCREMENT=0.2

# --- Corpus synthétique (mode OMEKA_MODE=synthetic uniquement) ---
SYNTHETIC_EXPLORER_AGENTS=6
SYNTHETIC_EXPLORER_STEPS=120

# --- LLM auto-hébergé (Agent Mastra "Chroniqueur Cognitif") ---
# Serveur exposant une API compatible OpenAI /chat/completions (Ollama par défaut) :
#   ollama serve && ollama pull llama3
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3

# --- Micro-service quantique (Espace Lisse) ---
# synthetic : approximation classique locale (aucun service requis)
# fastapi   : appel réel au micro-service Python/Qiskit Aer (voir quantum-service/)
#   cd quantum-service && python3 -m venv .venv && source .venv/bin/activate \
#     && pip install -r requirements.txt && uvicorn main:app --port 8000
QUANTUM_PROVIDER=synthetic
QUANTUM_SERVICE_URL=http://localhost:8000
QUANTUM_SHOTS=2048
QUANTUM_TOP_K=5
